<?xml version="1.0" encoding="UTF-8"?>
<?page title="Application Overview - AppTracker Pro"?>
<!-- Generated from: ui-screenshots/AppTracker.png -->
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:n="native">

    <style><![CDATA[
        /* === Base === */
        * { box-sizing: border-box; }
        .at-page {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: #0d1117;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #c9d1d9;
        }

        /* === Navbar === */
        .at-navbar {
            background: #161b22;
            border-bottom: 1px solid #30363d;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 56px;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .at-navbar-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }
        .at-logo {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #f0f6fc;
            font-weight: 700;
            font-size: 15px;
            white-space: nowrap;
        }
        .at-logo-icon {
            width: 28px;
            height: 28px;
            background: #3b82f6;
            border-radius: 6px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3px;
            padding: 5px;
        }
        .at-logo-dot {
            background: rgba(255,255,255,0.9);
            border-radius: 1px;
        }
        .at-search-wrap {
            position: relative;
        }
        .at-search-wrap .z-textbox {
            background: #0d1117 !important;
            border: 1px solid #30363d !important;
            color: #c9d1d9 !important;
            border-radius: 6px;
            padding: 5px 12px 5px 30px !important;
            width: 220px;
            font-size: 13px;
        }
        .at-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #8b949e;
            font-size: 12px;
            pointer-events: none;
            z-index: 1;
        }
        .at-nav-links {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
            gap: 2px;
        }
        .at-nav-links li a {
            color: #8b949e;
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
            display: block;
        }
        .at-nav-links li.active a {
            color: #f0f6fc;
            background: #21262d;
        }
        .at-nav-links li a:hover { color: #c9d1d9; }
        .at-navbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .at-icon-btn .z-button {
            background: transparent !important;
            border: 1px solid #30363d !important;
            color: #8b949e !important;
            border-radius: 6px;
            width: 34px;
            height: 34px;
            padding: 0;
        }
        .at-icon-btn .z-button:hover {
            background: #21262d !important;
            color: #c9d1d9 !important;
        }
        .at-avatar {
            width: 34px;
            height: 34px;
            background: #3b82f6;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        /* === Main Content === */
        .at-main {
            padding: 28px 24px;
            flex: 1;
        }

        /* === Page Header === */
        .at-page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 24px;
        }
        .at-page-title .z-label {
            color: #f0f6fc;
            font-size: 26px;
            font-weight: 700;
            display: block;
        }
        .at-page-subtitle .z-label {
            color: #8b949e;
            font-size: 14px;
            display: block;
            margin-top: 4px;
        }
        .at-header-actions {
            display: flex;
            gap: 10px;
            padding-top: 6px;
        }
        .at-btn-secondary .z-button {
            background: #21262d;
            border: 1px solid #30363d;
            color: #c9d1d9;
            border-radius: 6px;
            padding: 7px 14px;
            font-size: 14px;
            cursor: pointer;
        }
        .at-btn-secondary .z-button:hover { background: #30363d; }
        .at-btn-primary .z-button {
            background: #3b82f6;
            border: 1px solid #3b82f6;
            color: white;
            border-radius: 6px;
            padding: 7px 14px;
            font-size: 14px;
            cursor: pointer;
        }
        .at-btn-primary .z-button:hover { background: #2563eb; border-color: #2563eb; }
        .at-btn-outline .z-button {
            background: transparent;
            border: 1px solid #30363d;
            color: #c9d1d9;
            border-radius: 6px;
            padding: 8px 16px;
            font-size: 14px;
            cursor: pointer;
            width: 100%;
            margin-top: 12px;
        }
        .at-btn-outline .z-button:hover { background: #21262d; }
        .at-btn-chat .z-button {
            background: #3b82f6;
            border-color: #3b82f6;
            color: white;
            width: 100%;
        }
        .at-btn-chat .z-button:hover { background: #2563eb; border-color: #2563eb; }

        /* === Status Cards === */
        .at-status-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }
        .at-status-card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 10px;
            padding: 18px 20px;
        }
        .at-status-card-lbl {
            color: #8b949e;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 10px;
        }
        .at-status-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .at-status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #f59e0b;
            flex-shrink: 0;
        }
        .at-val-status .z-label { color: #f0f6fc; font-size: 15px; font-weight: 600; }
        .at-val-id .z-label    { color: #f0f6fc; font-size: 15px; font-weight: 600; }
        .at-val-date .z-label  { color: #f0f6fc; font-size: 15px; font-weight: 600; }
        .at-val-fee .z-label   { color: #3b82f6; font-size: 20px; font-weight: 700; }

        /* === Body Row === */
        .at-body-row {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }
        .at-left-col {
            flex: 2;
            display: flex;
            flex-direction: column;
            gap: 16px;
            min-width: 0;
        }
        .at-right-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
            min-width: 0;
        }

        /* === Cards === */
        .at-card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 10px;
            padding: 20px;
        }
        .at-card-hdr {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }
        .at-card-title .z-label { color: #f0f6fc; font-size: 15px; font-weight: 600; }
        .at-card-title-solo .z-label {
            color: #f0f6fc;
            font-size: 15px;
            font-weight: 600;
            display: block;
            margin-bottom: 14px;
        }

        /* === Progress === */
        .at-progress-pct .z-label { color: #3b82f6; font-size: 13px; font-weight: 600; }
        .at-progressmeter .z-progressmeter {
            background: #21262d !important;
            border-radius: 6px;
            height: 10px;
            border: none !important;
        }
        .at-progressmeter .z-progressmeter-bar {
            background: #3b82f6 !important;
            border-radius: 6px;
        }
        .at-progress-step .z-label {
            color: #8b949e;
            font-size: 13px;
            display: block;
            margin-top: 10px;
        }

        /* === Checklist Listbox === */
        .at-checklist .z-listbox,
        .at-checklist .z-listbox-body { background: transparent; border: none !important; }
        .at-checklist .z-listitem {
            background: transparent !important;
            border-bottom: 1px solid #21262d !important;
            cursor: default;
        }
        .at-checklist .z-listitem:last-child { border-bottom: none !important; }
        .at-checklist .z-listitem-selected,
        .at-checklist .z-listitem-over { background: #1c2333 !important; }
        .at-checklist .z-listcell { padding: 12px 4px; border: none !important; background: transparent !important; }
        .at-check-row { display: flex; align-items: center; gap: 12px; }
        .at-check-status {
            width: 26px; height: 26px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; font-size: 13px; font-weight: 700;
        }
        .at-done     { background: rgba(74,222,128,.15); color: #4ade80; }
        .at-progress { background: rgba(245,158,11,.15);  color: #f59e0b; font-size: 10px; }
        .at-upcoming { background: rgba(107,114,128,.15); color: #6b7280; font-size: 10px; }
        .at-check-info { flex: 1; min-width: 0; }
        .at-check-name { color: #f0f6fc; font-size: 14px; font-weight: 500; }
        .at-check-desc { color: #8b949e; font-size: 12px; margin-top: 2px; }
        .at-check-meta { text-align: right; flex-shrink: 0; }
        .at-check-date { color: #8b949e; font-size: 12px; }
        .at-badge {
            display: inline-block; padding: 2px 8px; border-radius: 4px;
            font-size: 11px; font-weight: 600;
        }
        .at-badge-progress { background: rgba(245,158,11,.15); color: #f59e0b; }
        .at-badge-upcoming { background: rgba(107,114,128,.15); color: #6b7280; }

        /* === Messages Listbox === */
        .at-messages .z-listbox,
        .at-messages .z-listbox-body { background: transparent; border: none !important; }
        .at-messages .z-listitem {
            background: transparent !important;
            border-bottom: 1px solid #21262d !important;
            cursor: default;
        }
        .at-messages .z-listitem:last-child { border-bottom: none !important; }
        .at-messages .z-listitem-selected,
        .at-messages .z-listitem-over { background: #1c2333 !important; }
        .at-messages .z-listcell { padding: 12px 4px; border: none !important; background: transparent !important; }
        .at-msg-row { display: flex; gap: 12px; align-items: flex-start; }
        .at-msg-avatar {
            width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 11px; font-weight: 700;
        }
        .at-msg-body { flex: 1; min-width: 0; }
        .at-msg-hdr  { display: flex; justify-content: space-between; align-items: baseline; }
        .at-msg-name { color: #f0f6fc; font-size: 13px; font-weight: 600; }
        .at-msg-time { color: #8b949e; font-size: 11px; }
        .at-msg-text {
            color: #8b949e; font-size: 12px; margin-top: 3px; line-height: 1.4;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .at-view-all .z-a { color: #58a6ff !important; font-size: 13px; text-decoration: none !important; }

        /* === Help Card === */
        .at-help-card {
            background: linear-gradient(135deg, #1c2333, #1a2236);
            border: 1px solid #30363d;
            border-radius: 10px;
            padding: 24px 20px;
            text-align: center;
        }
        .at-help-icon {
            width: 42px; height: 42px; border-radius: 50%;
            background: #3b82f6; color: white;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; font-weight: 700;
            margin: 0 auto 14px;
        }
        .at-help-title { color: #f0f6fc; font-size: 16px; font-weight: 600; margin-bottom: 8px; }
        .at-help-text  { color: #8b949e; font-size: 13px; line-height: 1.6; margin-bottom: 18px; }
    ]]></style>

    <div apply="zwriter.AppTrackerComposer" sclass="at-page">

        <!-- ===== Navbar ===== -->
        <n:nav class="at-navbar">
            <n:div class="at-navbar-left">
                <n:span class="at-logo">
                    <n:div class="at-logo-icon">
                        <n:div class="at-logo-dot"/>
                        <n:div class="at-logo-dot"/>
                        <n:div class="at-logo-dot"/>
                        <n:div class="at-logo-dot"/>
                    </n:div>
                    AppTracker Pro
                </n:span>
                <n:div class="at-search-wrap">
                    <n:i class="z-icon-search at-search-icon"/>
                    <textbox id="searchBox" placeholder="Search applications..." />
                </n:div>
                <n:ul class="at-nav-links">
                    <n:li class="active"><n:a href="#">Dashboard</n:a></n:li>
                    <n:li><n:a href="#">Applications</n:a></n:li>
                    <n:li><n:a href="#">Documents</n:a></n:li>
                    <n:li><n:a href="#">Messages</n:a></n:li>
                </n:ul>
            </n:div>
            <n:div class="at-navbar-right">
                <button iconSclass="z-icon-bell-o" tooltiptext="Notifications" sclass="at-icon-btn"/>
                <button iconSclass="z-icon-cog"    tooltiptext="Settings"       sclass="at-icon-btn"/>
                <n:div class="at-avatar">JD</n:div>
            </n:div>
        </n:nav>

        <!-- ===== Main Content ===== -->
        <n:div class="at-main">

            <!-- Page Header -->
            <n:div class="at-page-header">
                <n:div>
                    <label value="Application Overview" sclass="at-page-title"/>
                    <label value="Track your progress and respond to inquiries in real-time." sclass="at-page-subtitle"/>
                </n:div>
                <n:div class="at-header-actions">
                    <button id="exportPdfBtn"  label="Export PDF"   iconSclass="z-icon-download" sclass="at-btn-secondary"/>
                    <button id="editDetailsBtn" label="Edit Details" iconSclass="z-icon-pencil"   sclass="at-btn-primary"/>
                </n:div>
            </n:div>

            <!-- Status Cards -->
            <n:div class="at-status-cards">
                <n:div class="at-status-card">
                    <n:div class="at-status-card-lbl">APPLICATION STATUS</n:div>
                    <n:div class="at-status-row">
                        <n:span class="at-status-dot"/>
                        <label id="appStatusLabel" sclass="at-val-status"/>
                    </n:div>
                </n:div>
                <n:div class="at-status-card">
                    <n:div class="at-status-card-lbl">APPLICATION ID</n:div>
                    <label id="appIdLabel" sclass="at-val-id"/>
                </n:div>
                <n:div class="at-status-card">
                    <n:div class="at-status-card-lbl">SUBMISSION DATE</n:div>
                    <label id="submissionDateLabel" sclass="at-val-date"/>
                </n:div>
                <n:div class="at-status-card">
                    <n:div class="at-status-card-lbl">PROCESSING FEE</n:div>
                    <label id="processingFeeLabel" sclass="at-val-fee"/>
                </n:div>
            </n:div>

            <!-- Body Row -->
            <n:div class="at-body-row">

                <!-- Left Column -->
                <n:div class="at-left-col">

                    <!-- Overall Progress Card -->
                    <n:div class="at-card">
                        <n:div class="at-card-hdr">
                            <label value="Overall Progress" sclass="at-card-title"/>
                            <label id="progressPctLabel" sclass="at-progress-pct"/>
                        </n:div>
                        <progressmeter id="progressBar" value="85" hflex="1" sclass="at-progressmeter"/>
                        <label id="progressStepLabel" sclass="at-progress-step"/>
                    </n:div>

                    <!-- Required Checklist Card -->
                    <n:div class="at-card">
                        <label value="Required Checklist" sclass="at-card-title-solo"/>
                        <listbox id="checklistBox" hflex="1" sclass="at-checklist">
                            <!-- Items populated by AppTrackerComposer -->
                        </listbox>
                    </n:div>

                </n:div><!-- end at-left-col -->

                <!-- Right Column -->
                <n:div class="at-right-col">

                    <!-- Recent Messages Card -->
                    <n:div class="at-card">
                        <n:div class="at-card-hdr">
                            <label value="Recent Messages" sclass="at-card-title"/>
                            <a id="viewAllLink" label="View All" sclass="at-view-all"/>
                        </n:div>
                        <listbox id="messagesBox" hflex="1" sclass="at-messages">
                            <!-- Messages populated by AppTrackerComposer -->
                        </listbox>
                        <button id="sendMessageBtn" label="Send New Message" hflex="1" sclass="at-btn-outline"/>
                    </n:div>

                    <!-- Need Help? Card -->
                    <n:div class="at-help-card">
                        <n:div class="at-help-icon">?</n:div>
                        <n:div class="at-help-title">Need Help?</n:div>
                        <n:div class="at-help-text">
                            Our support team is available 24/7 to guide you through the process.
                        </n:div>
                        <button id="liveChatBtn" label="Live Chat Support"  sclass="at-btn-primary at-btn-chat"/>
                    </n:div>

                </n:div><!-- end at-right-col -->

            </n:div><!-- end at-body-row -->

        </n:div><!-- end at-main -->

    </div>

</zk>