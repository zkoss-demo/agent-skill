<?page title="Test Case Management"?>
<zk xmlns:n="native" xmlns:ca="client/attribute">
<style>
.tc-app {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    height: 100vh;
    display: flex;
    flex-direction: column;
}
/* Top Nav */
.tc-nav {
    display: flex;
    align-items: center;
    padding: 0 16px;
    height: 48px;
    background: #1a1a2e;
    color: #fff;
    gap: 8px;
}
.tc-nav-logo {
    font-weight: 700;
    font-size: 15px;
    color: #fff;
    margin-right: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.tc-nav-logo span {
    background: #4f8ef7;
    color: #fff;
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 13px;
    font-weight: 800;
    margin-right: 4px;
}
.tc-nav-link {
    color: #b0b8d4;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 13px;
    padding: 6px 10px;
    border-radius: 5px;
}
.tc-nav-link:hover, .tc-nav-link.active {
    color: #fff;
    background: rgba(255,255,255,0.08);
}
.tc-nav-link.active {
    color: #4f8ef7;
}
.tc-nav-spacer { flex: 1; }
.tc-search-wrap {
    background: rgba(255,255,255,0.10);
    border-radius: 20px;
    padding: 4px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #b0b8d4;
    font-size: 13px;
    width: 180px;
}
.tc-nav-icon {
    background: none;
    border: none;
    color: #b0b8d4;
    cursor: pointer;
    font-size: 15px;
    padding: 5px;
    border-radius: 50%;
}
.tc-nav-icon:hover { color: #fff; }
.tc-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #4f8ef7;
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700;
    cursor: pointer;
}
/* Project Explorer */
.tc-sidebar {
    padding: 0;
    background: #f5f6fa;
    border-right: 1px solid #e0e3ed;
    height: 100%;
    display: flex;
    flex-direction: column;
}
.tc-sidebar-header {
    font-size: 11px;
    font-weight: 700;
    color: #7b8aab;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 16px 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.tc-sidebar-footer {
    margin-top: auto;
    padding: 12px;
    border-top: 1px solid #e0e3ed;
}
.z-tree {
    background: transparent;
    border: none;
}
.z-tree-body { background: transparent; }
.tc-tree-node {
    font-size: 13px;
    color: #3a4060;
}
.tc-tree-node.selected, .z-treerow-seld .tc-tree-node {
    color: #2563eb;
    font-weight: 600;
}
/* Center panel */
.tc-center {
    padding: 18px 24px 0 24px;
    background: #fff;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: auto;
}
.tc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #7b8aab;
    margin-bottom: 10px;
}
.tc-breadcrumb a {
    color: #7b8aab;
    text-decoration: none;
}
.tc-breadcrumb a:hover { color: #2563eb; text-decoration: underline; }
.tc-breadcrumb-sep { color: #c5cadd; }
.tc-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}
.tc-title {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0;
}
.tc-title-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}
.tc-badge-draft {
    background: #fff7e0;
    color: #b45309;
    border: 1px solid #fcd34d;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    letter-spacing: 0.05em;
}
.tc-meta {
    font-size: 12px;
    color: #7b8aab;
    margin-bottom: 16px;
}
.tc-meta strong { color: #3a4060; }
/* Steps table */
.z-listbox { border: 1px solid #e0e3ed; border-radius: 8px; }
.z-listheader { background: #f5f6fa; color: #7b8aab; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
.tc-step-num { color: #7b8aab; font-size: 13px; font-weight: 600; }
.tc-step-action { font-size: 13px; font-weight: 600; color: #1a1a2e; }
.tc-step-result { font-size: 13px; color: #4a5072; }
.tc-row-actions { display: flex; align-items: center; gap: 4px; }
.tc-icon-btn {
    background: none;
    border: 1px solid #e0e3ed;
    border-radius: 5px;
    color: #7b8aab;
    cursor: pointer;
    font-size: 13px;
    padding: 3px 6px;
    line-height: 1;
}
.tc-icon-btn:hover { background: #f0f4ff; color: #2563eb; border-color: #b6c9fb; }
.tc-icon-btn.danger:hover { background: #fff0f0; color: #dc2626; border-color: #fca5a5; }
.tc-add-step {
    margin-top: 12px;
    margin-bottom: 16px;
}
/* Step config panel */
.tc-config {
    padding: 16px;
    background: #fff;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-left: 1px solid #e0e3ed;
    overflow: auto;
}
.tc-config-header {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 2px;
}
.tc-config-sub {
    font-size: 11px;
    color: #7b8aab;
    margin-bottom: 16px;
}
.tc-config-divider {
    border: none;
    border-top: 1px solid #e0e3ed;
    margin: 12px 0;
}
.tc-field-label {
    font-size: 11px;
    font-weight: 700;
    color: #7b8aab;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 5px;
}
.tc-locator-group {
    display: flex;
    gap: 0;
    border: 1px solid #e0e3ed;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 12px;
}
.tc-locator-btn {
    flex: 1;
    background: #f5f6fa;
    border: none;
    border-right: 1px solid #e0e3ed;
    color: #7b8aab;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 0;
    cursor: pointer;
    transition: background 0.15s;
}
.tc-locator-btn:last-child { border-right: none; }
.tc-locator-btn.selected {
    background: #2563eb;
    color: #fff;
}
.tc-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}
.tc-toggle-label { font-size: 13px; color: #3a4060; font-weight: 500; }
.tc-toggle-hint { font-size: 11px; color: #7b8aab; margin-bottom: 12px; }
.tc-preview {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #e0e3ed;
}
.tc-preview-label { font-size: 11px; color: #7b8aab; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 8px; }
.tc-preview-thumbs { display: flex; gap: 6px; }
.tc-preview-thumb {
    width: 70px; height: 48px;
    background: #f0f4ff;
    border: 1px solid #e0e3ed;
    border-radius: 5px;
    display: flex; align-items: center; justify-content: center;
    color: #c5cadd; font-size: 18px;
}
.tc-btn-primary {
    background: #1a1a2e;
    color: #fff;
    border: none;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 0;
    width: 100%;
    cursor: pointer;
    margin-bottom: 8px;
}
.tc-btn-primary:hover { background: #2d2d4e; }
.tc-btn-secondary {
    background: #fff;
    color: #3a4060;
    border: 1px solid #e0e3ed;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 0;
    width: 100%;
    cursor: pointer;
}
.tc-btn-secondary:hover { background: #f5f6fa; }
/* Status bar */
.tc-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    color: #7b8aab;
    padding: 0 16px;
    height: 28px;
    background: #f5f6fa;
    border-top: 1px solid #e0e3ed;
}
.tc-statusbar-left { display: flex; align-items: center; gap: 6px; }
.tc-status-dot {
    width: 8px; height: 8px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
}
/* Export btn */
.z-button.export-btn {
    background: #fff;
    border: 1px solid #e0e3ed;
    color: #3a4060;
    border-radius: 7px;
    font-size: 13px;
    padding: 5px 14px;
}
.z-button.run-btn {
    background: #2563eb;
    border: none;
    color: #fff;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    padding: 5px 14px;
}
.z-button.run-btn:hover { background: #1d4ed8; }
.z-button.add-step-btn {
    background: none;
    border: none;
    color: #2563eb;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 0;
}
.z-button.add-step-btn:hover { text-decoration: underline; }
</style>
<div apply="zwriter.TestCaseManagementComposer" sclass="tc-app" vflex="1">

    <!-- Top Navigation Bar -->
    <n:div class="tc-nav">
        <n:div class="tc-nav-logo">
            <n:span>T</n:span>TestFlow Pro
        </n:div>
        <n:button class="tc-nav-link">Dashboard</n:button>
        <n:button class="tc-nav-link active">Test Suites</n:button>
        <n:button class="tc-nav-link">Runs</n:button>
        <n:button class="tc-nav-link">Reports</n:button>
        <n:div class="tc-nav-spacer"/>
        <n:div class="tc-search-wrap">
            <n:span>&#x1F50D;</n:span>
            <n:span>Search tests...</n:span>
        </n:div>
        <n:button class="tc-nav-icon">&#x1F514;</n:button>
        <n:button class="tc-nav-icon">&#x2699;&#xFE0F;</n:button>
        <n:div class="tc-avatar">JD</n:div>
    </n:div>

    <!-- Main Body -->
    <borderlayout vflex="1">

        <!-- Left: Project Explorer -->
        <west title="PROJECT EXPLORER" size="200px" splittable="true" collapsible="true" border="none">
            <div sclass="tc-sidebar" vflex="1">
                <div sclass="tc-sidebar-header">
                    Project Explorer
                    <button id="collapseAllBtn" iconSclass="z-icon-compress" tooltiptext="Collapse All"/>
                </div>
                <tree id="projectTree" vflex="1" sclass="z-tree">
                    <treecols visible="false">
                        <treecol/>
                    </treecols>
                    <treechildren>
                        <treeitem open="true">
                            <treerow >
                                <treecell >
                                    <a iconSclass="z-icon-folder-open" sclass="tc-tree-node" label="E-commerce App"/>
                                </treecell>
                            </treerow>
                            <treechildren>
                                <treeitem open="true">
                                    <treerow>
                                        <treecell>
                                            <a iconSclass="z-icon-folder-open" sclass="tc-tree-node" label="Auth Module"/>
                                        </treecell>
                                    </treerow>
                                    <treechildren>
                                        <treeitem>
                                            <treerow sclass="z-treerow-seld">
                                                <treecell>
                                                    <a iconSclass="z-icon-file-text" sclass="tc-tree-node selected" label="Login Test"/>
                                                </treecell>
                                            </treerow>
                                        </treeitem>
                                        <treeitem>
                                            <treerow>
                                                <treecell>
                                                    <a iconSclass="z-icon-file-text" sclass="tc-tree-node" label="Signup Flow"/>
                                                </treecell>
                                            </treerow>
                                        </treeitem>
                                        <treeitem>
                                            <treerow>
                                                <treecell>
                                                    <a iconSclass="z-icon-file-text" sclass="tc-tree-node" label="Password Recovery"/>
                                                </treecell>
                                            </treerow>
                                        </treeitem>
                                    </treechildren>
                                </treeitem>
                                <treeitem>
                                    <treerow>
                                        <treecell>
                                            <a iconSclass="z-icon-folder" sclass="tc-tree-node" label="Payment Flow"/>
                                        </treecell>
                                    </treerow>
                                </treeitem>
                                <treeitem>
                                    <treerow>
                                        <treecell>
                                            <a iconSclass="z-icon-folder" sclass="tc-tree-node" label="Shopping Cart"/>
                                        </treecell>
                                    </treerow>
                                </treeitem>
                                <treeitem>
                                    <treerow>
                                        <treecell>
                                            <a iconSclass="z-icon-folder" sclass="tc-tree-node" label="Inventory Management"/>
                                        </treecell>
                                    </treerow>
                                </treeitem>
                            </treechildren>
                        </treeitem>
                    </treechildren>
                </tree>
                <div sclass="tc-sidebar-footer">
                    <button id="newTestCaseBtn" label="+ New Test Case" hflex="1" iconSclass="z-icon-plus"/>
                </div>
            </div>
        </west>

        <!-- Center: Test Case Editor -->
        <center autoscroll="true" border="none">
            <div sclass="tc-center" vflex="1">

                <!-- Breadcrumb -->
                <n:nav class="tc-breadcrumb">
                    <n:a href="#">E-commerce App</n:a>
                    <n:span class="tc-breadcrumb-sep"> / </n:span>
                    <n:a href="#">Auth Module</n:a>
                    <n:span class="tc-breadcrumb-sep"> / </n:span>
                    <n:span>Login Test</n:span>
                </n:nav>

                <!-- Title Row -->
                <n:div class="tc-title-row">
                    <n:div style="display:flex;align-items:center;gap:10px;">
                        <n:h2 class="tc-title">Login Test Case</n:h2>
                        <n:span class="tc-badge-draft">DRAFT</n:span>
                        <button id="refreshBtn" iconSclass="z-icon-refresh" tooltiptext="Refresh"/>
                    </n:div>
                    <n:div class="tc-title-actions">
                        <button id="exportBtn" label="Export" sclass="export-btn" iconSclass="z-icon-share-square"/>
                        <button id="runTestBtn" label=" Run Test" sclass="run-btn" iconSclass="z-icon-play"/>
                    </n:div>
                </n:div>

                <!-- Metadata -->
                <div sclass="tc-meta">
                    <label id="testCaseId" value="TC-102"/> &#x2022;
                    Last edited by <label id="lastEditedBy" value="John Doe"/> <label id="lastEditedTime" value="2h ago"/>
                </div>

                <!-- Test Steps Listbox -->
                <listbox id="stepsListbox" vflex="1" checkmark="false" nonselectableTags="button">
                    <listhead>
                        <listheader label="#"   width="50px"  sclass="z-listheader"/>
                        <listheader label="ACTION"          hflex="1" sclass="z-listheader"/>
                        <listheader label="EXPECTED RESULT" hflex="2" sclass="z-listheader"/>
                        <listheader label="ACTIONS"         width="120px" sclass="z-listheader"/>
                    </listhead>
                    <listitem>
                        <listcell><label sclass="tc-step-num" value="1"/></listcell>
                        <listcell><label sclass="tc-step-action" value="Navigate to /login"/></listcell>
                        <listcell><label sclass="tc-step-result" value="Login page is displayed with username/password fields"/></listcell>
                        <listcell>
                            <n:div class="tc-row-actions">
                                <n:button class="tc-icon-btn" title="Move Up">&#x2191;</n:button>
                                <n:button class="tc-icon-btn" title="Move Down">&#x2193;</n:button>
                                <n:button class="tc-icon-btn" title="Edit">&#x270E;</n:button>
                                <n:button class="tc-icon-btn danger" title="Delete">&#x1F5D1;</n:button>
                            </n:div>
                        </listcell>
                    </listitem>
                    <listitem selected="true">
                        <listcell><label sclass="tc-step-num" value="2"/></listcell>
                        <listcell><label sclass="tc-step-action" value="Enter valid credentials"/></listcell>
                        <listcell><label sclass="tc-step-result" value="Credentials are accepted, login button becomes active"/></listcell>
                        <listcell>
                            <n:div class="tc-row-actions">
                                <n:button class="tc-icon-btn" title="Move Up">&#x2191;</n:button>
                                <n:button class="tc-icon-btn" title="Move Down">&#x2193;</n:button>
                                <n:button class="tc-icon-btn" title="Edit">&#x270E;</n:button>
                                <n:button class="tc-icon-btn danger" title="Delete">&#x1F5D1;</n:button>
                            </n:div>
                        </listcell>
                    </listitem>
                    <listitem>
                        <listcell><label sclass="tc-step-num" value="3"/></listcell>
                        <listcell><label sclass="tc-step-action" value="Click 'Submit' button"/></listcell>
                        <listcell><label sclass="tc-step-result" value="User is redirected to user dashboard with welcome message"/></listcell>
                        <listcell>
                            <n:div class="tc-row-actions">
                                <n:button class="tc-icon-btn" title="Move Up">&#x2191;</n:button>
                                <n:button class="tc-icon-btn" title="Move Down">&#x2193;</n:button>
                                <n:button class="tc-icon-btn" title="Edit">&#x270E;</n:button>
                                <n:button class="tc-icon-btn danger" title="Delete">&#x1F5D1;</n:button>
                            </n:div>
                        </listcell>
                    </listitem>
                </listbox>

                <!-- Add New Step -->
                <div sclass="tc-add-step">
                    <button id="addStepBtn" label="+ Add New Step" sclass="add-step-btn" iconSclass="z-icon-plus-circle"/>
                </div>

            </div>
        </center>

        <!-- Right: Step Configuration -->
        <east size="240px" splittable="true" collapsible="true" title="Step Configuration" border="none">
            <div sclass="tc-config" vflex="1">
                <div sclass="tc-config-header">Step Configuration</div>
                <div sclass="tc-config-sub">Configuring Step #2</div>

                <n:hr class="tc-config-divider"/>

                <!-- ACTION TYPE -->
                <div sclass="tc-field-label">ACTION TYPE</div>
                <combobox id="actionTypeCombo" hflex="1" value="Type Text" readonly="false">
                    <comboitem label="Type Text"/>
                    <comboitem label="Click Element"/>
                    <comboitem label="Navigate To"/>
                    <comboitem label="Assert Text"/>
                    <comboitem label="Wait For Element"/>
                    <comboitem label="Take Screenshot"/>
                </combobox>

                <n:hr class="tc-config-divider"/>

                <!-- INPUT DATA -->
                <div sclass="tc-field-label">INPUT DATA</div>
                <textbox id="inputDataBox" hflex="1" placeholder="Leave empty if no input is required"
                         value="admin_user@test.com"/>

                <n:hr class="tc-config-divider"/>

                <!-- LOCATOR TYPE -->
                <div sclass="tc-field-label">LOCATOR TYPE</div>
                <radiogroup id="locatorTypeGroup">
                    <n:div class="tc-locator-group">
                        <n:button id="locCssBtn" class="tc-locator-btn selected"
                                  ca:onclick="zkLocatorSelect(this, 'css')">CSS Selector</n:button>
                        <n:button id="locXpathBtn" class="tc-locator-btn"
                                  ca:onclick="zkLocatorSelect(this, 'xpath')">XPath</n:button>
                        <n:button id="locIdBtn" class="tc-locator-btn"
                                  ca:onclick="zkLocatorSelect(this, 'id')">ID</n:button>
                    </n:div>
                </radiogroup>

                <!-- LOCATOR VALUE -->
                <div sclass="tc-field-label">LOCATOR VALUE</div>
                <textbox id="locatorValueBox" hflex="1" value="#username-input"/>

                <n:hr class="tc-config-divider"/>

                <!-- Screenshot on Failure -->
                <n:div class="tc-toggle-row">
                    <n:span class="tc-toggle-label">Screenshot on Failure</n:span>
                    <checkbox id="screenshotToggle" mold="toggle" checked="true"/>
                </n:div>
                <div sclass="tc-toggle-hint">Capture UI state if step fails</div>

                <n:hr class="tc-config-divider"/>

                <!-- Action Buttons -->
                <n:button class="tc-btn-primary" id="saveConfigNativeBtn">Save Configuration</n:button>
                <n:button class="tc-btn-secondary" id="resetChangesNativeBtn">Reset Changes</n:button>

                <!-- Preview Element (placeholder) -->
                <div sclass="tc-preview">
                    <div sclass="tc-preview-label">Preview Element</div>
                    <n:div class="tc-preview-thumbs">
                        <n:div class="tc-preview-thumb">&#x1F5BC;</n:div>
                        <n:div class="tc-preview-thumb">&#x1F5BC;</n:div>
                        <n:div class="tc-preview-thumb">&#x1F5BC;</n:div>
                    </n:div>
                </div>
            </div>
        </east>

    </borderlayout>

    <!-- Status Bar -->
    <n:div class="tc-statusbar">
        <n:div class="tc-statusbar-left">
            <n:span class="tc-status-dot"/>
            <n:span>Connected to Cloud Agent</n:span>
        </n:div>
        <n:span>Project: E-commerce_Prod_v2</n:span>
        <n:span>Total Steps: 3 &#160; Estimated Time: 1m 45s</n:span>
    </n:div>

</div>

<script>
function zkLocatorSelect(btn, type) {
    var btns = btn.parentNode.querySelectorAll('.tc-locator-btn');
    btns.forEach(function(b) { b.classList.remove('selected'); });
    btn.classList.add('selected');
}
</script>
</zk>
