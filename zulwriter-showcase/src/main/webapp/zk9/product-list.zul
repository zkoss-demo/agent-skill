<?xml version="1.0" encoding="UTF-8"?>
<?page title="Product Catalog"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:n="native">
    <window id="productListWin" title="Product Catalog" border="normal"
            hflex="1" vflex="1"
            viewModel="@id('vm') @init('zwriter.ProductListViewModel')">
        <vlayout vflex="1" hflex="1" spacing="10px" style="padding: 10px">

            <!-- Search and Filter Bar -->
            <hlayout valign="middle" hflex="1" spacing="8px">
                <textbox value="@bind(vm.searchKeyword)"
                         placeholder="Search products by name..."
                         hflex="1" instant="true"
                         onChange="@command('search')"/>
                <button label="Search" onClick="@command('search')"
                        iconSclass="z-icon-search" />
            </hlayout>

            <!-- Filters Row -->
            <hlayout valign="middle" hflex="1" spacing="8px">
                <label value="Category:" sclass="filter-label"/>
                <combobox model="@load(vm.categories)"
                          selectedItem="@bind(vm.selectedCategory)"
                          readonly="true" hflex="min"
                          placeholder="All Categories"
                          onSelect="@command('applyFilters')">
                    <template name="model" var="cat">
                        <comboitem label="@load(cat)"/>
                    </template>
                </combobox>

                <label value="Sort by:" sclass="filter-label"/>
                <combobox model="@load(vm.sortOptions)"
                          selectedItem="@bind(vm.selectedSortOption)"
                          readonly="true" hflex="min"
                          onSelect="@command('applyFilters')">
                    <template name="model" var="opt">
                        <comboitem label="@load(opt)"/>
                    </template>
                </combobox>

                <label value="Price:" sclass="filter-label"/>
                <doublebox value="@bind(vm.minPrice)" width="80px"
                           placeholder="Min"
                           onChange="@command('applyFilters')"/>
                <label value="-"/>
                <doublebox value="@bind(vm.maxPrice)" width="80px"
                           placeholder="Max"
                           onChange="@command('applyFilters')"/>

                <space hflex="1"/>
                <button label="Clear Filters" onClick="@command('clearFilters')"
                        iconSclass="z-icon-times" hflex="min"/>
            </hlayout>

            <separator/>

            <!-- Results Summary -->
            <hlayout valign="middle" hflex="1">
                <label value="@load(vm.resultSummary)"
                       style="color: #666; font-size: 13px"/>
                <space hflex="1"/>
            </hlayout>

            <!-- Product Grid -->
            <listbox model="@load(vm.filteredProducts)"
                     selectedItem="@bind(vm.selectedProduct)"
                     hflex="1" vflex="1"
                     emptyMessage="No products match your search criteria.">
                <listhead>
                    <listheader label="" width="80px"/>
                    <listheader label="Product Name" hflex="2" sort="auto(name)"/>
                    <listheader label="Category" hflex="1" sort="auto(category)"/>
                    <listheader label="Price" width="120px" sort="auto(price)" align="right"/>
                    <listheader label="Actions" width="100px" align="center"/>
                </listhead>
                <template name="model" var="product">
                    <listitem>
                        <listcell>
                            <image src="@load(product.imageUrl)"
                                   width="60px" height="60px"/>
                        </listcell>
                        <listcell>
                            <vlayout spacing="2px">
                                <label value="@load(product.name)"
                                       style="font-weight: bold"/>
                                <label value="@load(product.description)"
                                       maxlength="80"
                                       style="color: #888; font-size: 12px"/>
                            </vlayout>
                        </listcell>
                        <listcell label="@load(product.category)"/>
                        <listcell label="@load(product.formattedPrice)"/>
                        <listcell>
                            <button label="View"
                                    onClick="@command('viewProduct', product=product)"
                                    iconSclass="z-icon-eye" hflex="min"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

            <!-- Paging -->
            <paging totalSize="@load(vm.totalSize)"
                    pageSize="@load(vm.pageSize)"
                    activePage="@bind(vm.activePage)"
                    onPaging="@command('onPaging')"/>

        </vlayout>
    </window>
</zk>
