<?xml version="1.0" encoding="UTF-8"?>
<?page title="Monthly Feedback Dashboard"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:n="native">

    <borderlayout hflex="1" vflex="1">

        <!-- Navigation Bar -->
        <north height="60px" border="none">
            <div style="background: #ffffff; border-bottom: 1px solid #e8ecf0;
                        padding: 0 24px; height: 100%;
                        display: flex; align-items: center;">
                <hlayout valign="middle" hflex="1" spacing="12px"
                         style="height: 100%; align-items: center;">
                    <!-- Brand logo circle -->
                    <n:div style="width: 30px; height: 30px; background: #2d6be4; border-radius: 50%;
                                  display: flex; align-items: center; justify-content: center;
                                  color: white; font-weight: bold; font-size: 14px; flex-shrink: 0;">F</n:div>
                    <label value="Feedback Central"
                           style="font-size: 15px; font-weight: 600; color: #1a1a2e;"/>
                    <space hflex="1"/>
                    <!-- Notification bell -->
                    <button iconSclass="z-icon-bell" tooltiptext="Notifications"
                            style="background: transparent; border: none; color: #555;
                                   font-size: 16px; padding: 4px 8px;"/>
                    <!-- User avatar -->
                    <button id="userAvatarBtn" iconSclass="z-icon-user-circle"
                            style="background: transparent; border: none; color: #555;
                                   font-size: 22px; padding: 4px 8px;"/>
                </hlayout>
            </div>
        </north>

        <!-- Main Content Area -->
        <center border="none" style="background: #f0f2f7;">
            <vlayout hflex="1" vflex="1" spacing="0"
                     style="padding: 36px 40px; overflow: auto;">

                <!-- Page Title -->
                <label value="Monthly Feedback Dashboard"
                       style="font-size: 26px; font-weight: bold; color: #1a1a2e;
                              margin-bottom: 24px;"/>

                <!-- ─── Current Month's Feedback Card ─── -->
                <div style="background: white; border-radius: 12px; padding: 24px 28px;
                            box-shadow: 0 1px 4px rgba(0,0,0,0.07); margin-bottom: 32px;">
                    <label value="Current Month's Feedback"
                           style="font-size: 17px; font-weight: 600; color: #1a1a2e;
                                  display: block; margin-bottom: 18px;"/>

                    <!-- Progress label row -->
                    <hlayout hflex="1" valign="middle" style="margin-bottom: 6px;">
                        <label value="Feedback Submission Progress"
                               style="font-size: 13px; color: #666;"/>
                        <space hflex="1"/>
                        <label value="60% Complete"
                               style="font-size: 13px; color: #2d6be4; font-weight: 600;"/>
                    </hlayout>

                    <!-- Progress bar -->
                    <progressmeter id="submissionProgress" value="60" hflex="1"
                                   style="margin-bottom: 18px;"/>

                    <!-- Submission message -->
                    <n:p style="font-size: 14px; color: #555; line-height: 1.6; margin: 0 0 20px 0;">
                        Please submit your feedback for
                        <n:strong style="color: #1a1a2e;">October 2023</n:strong>
                        by the end of the day. Your insights are valuable and help us improve the workplace.
                    </n:p>

                    <!-- Submit button -->
                    <button id="submitFeedbackBtn" label="Submit Feedback"
                            iconSclass="z-icon-paper-plane"
                            style="background: #2d6be4; color: white; border: none;
                                   padding: 9px 18px; border-radius: 6px; font-size: 13px;
                                   font-weight: 500;"/>
                </div>

                <!-- ─── Previous Months' Feedback Summary ─── -->
                <label value="Previous Months' Feedback Summary"
                       style="font-size: 18px; font-weight: bold; color: #1a1a2e;
                              display: block; margin-bottom: 16px;"/>

                <!-- Two chart cards side by side -->
                <hlayout hflex="1" spacing="16px" valign="top">

                    <!-- Overall Satisfaction Trends card -->
                    <vlayout hflex="1"
                             style="background: white; border-radius: 12px;
                                    padding: 20px 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.07);">
                        <hlayout hflex="1" valign="middle">
                            <label value="Overall Satisfaction Trends"
                                   style="font-size: 13px; font-weight: 600; color: #555;"/>
                            <space hflex="1"/>
                            <button iconSclass="z-icon-line-chart"
                                    style="background: transparent; border: none;
                                           color: #2d6be4; font-size: 16px; padding: 0;"/>
                        </hlayout>
                        <label value="4.2/5"
                               style="font-size: 34px; font-weight: bold; color: #1a1a2e;
                                      margin-top: 8px;"/>
                        <label value="Last 6 Months ↑ +5%"
                               style="font-size: 12px; color: #27ae60; margin-bottom: 12px;"/>
                        <charts id="satisfactionChart" type="bar" hflex="1" height="180px"/>
                    </vlayout>

                    <!-- Feedback Themes card -->
                    <vlayout hflex="1"
                             style="background: white; border-radius: 12px;
                                    padding: 20px 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.07);">
                        <hlayout hflex="1" valign="middle">
                            <label value="Feedback Themes"
                                   style="font-size: 13px; font-weight: 600; color: #555;"/>
                            <space hflex="1"/>
                            <button iconSclass="z-icon-sitemap"
                                    style="background: transparent; border: none;
                                           color: #9b59b6; font-size: 16px; padding: 0;"/>
                        </hlayout>
                        <label value="3 themes"
                               style="font-size: 34px; font-weight: bold; color: #1a1a2e;
                                      margin-top: 8px;"/>
                        <label value="Last 6 Months ↑ +10%"
                               style="font-size: 12px; color: #27ae60; margin-bottom: 12px;"/>
                        <charts id="themesChart" type="spline" hflex="1" height="180px"/>
                    </vlayout>

                </hlayout>

            </vlayout>
        </center>

        <!-- Footer -->
        <south height="44px" border="none">
            <div style="background: white; border-top: 1px solid #e8ecf0;
                        display: flex; align-items: center; justify-content: center;
                        height: 100%;">
                <label value="© 2023 Company Name. All rights reserved."
                       style="font-size: 12px; color: #999;"/>
            </div>
        </south>

    </borderlayout>
</zk>
