<?xml version="1.0" encoding="UTF-8"?>
<?page title="Bank Reconciliation Dashboard"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:ca="client/attribute" xmlns:w="client" xmlns:x="xhtml">
<style>
    .recon-page { background: #f5f7fa; }

    /* Header */
    .recon-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 24px; background: #fff; border-bottom: 1px solid #e2e8f0;
        height: 56px; box-sizing: border-box;
    }
    .recon-header-left { display: flex; align-items: center; gap: 32px; }
    .recon-logo { font-size: 18px; font-weight: 700; color: #1a202c; }
    .recon-logo-accent { color: #3b82f6; }
    .recon-nav { display: flex; gap: 4px; }
    .recon-nav-item {
        padding: 8px 16px; font-size: 14px; color: #64748b; cursor: pointer;
        border-bottom: 2px solid transparent; text-decoration: none;
        transition: color 0.15s, border-color 0.15s;
    }
    .recon-nav-item:hover { color: #1e40af; }
    .recon-nav-item--active { color: #3b82f6; border-bottom-color: #3b82f6; font-weight: 600; }
    .recon-user { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #334155; }
    .recon-avatar {
        width: 32px; height: 32px; border-radius: 50%; background: #3b82f6;
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 600;
    }

    /* Summary section */
    .recon-summary {
        display: flex; align-items: center; gap: 20px;
        padding: 20px 24px; background: #fff;
        border-bottom: 1px solid #e2e8f0;
    }
    .recon-stat-card {
        padding: 12px 20px; border-radius: 8px;
        border: 1px solid #e2e8f0; background: #fff; min-width: 180px;
    }
    .recon-stat-label {
        font-size: 11px; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.5px; color: #64748b; margin-bottom: 4px;
    }
    .recon-stat-label--warn { color: #dc2626; }
    .recon-stat-value { font-size: 22px; font-weight: 700; color: #1a202c; }
    .recon-stat-value--warn { color: #dc2626; }
    .recon-stat-currency { font-size: 13px; font-weight: 400; color: #94a3b8; margin-left: 4px; }
    .recon-summary-actions {
        display: flex; align-items: center; gap: 12px; margin-left: auto;
    }
    .recon-progress { font-size: 13px; color: #64748b; text-align: right; white-space: nowrap; }
    .recon-progress-pct { font-weight: 600; color: #16a34a; }

    /* Tabs filter bar */
    .recon-filter-bar {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 0;
    }
    .recon-filter-spacer { flex: 1; }

    /* Table */
    .recon-content { padding: 0 24px 16px; }
    .recon-desc-main { font-weight: 500; color: #1a202c; }
    .recon-desc-sub { font-size: 12px; color: #94a3b8; margin-top: 2px; }
    .recon-amount { font-weight: 500; font-variant-numeric: tabular-nums; }
    .recon-amount--credit { color: #16a34a; }
    .recon-amount--debit { color: #dc2626; }

    /* Status badges */
    .recon-badge {
        display: inline-block; padding: 2px 10px; border-radius: 12px;
        font-size: 12px; font-weight: 600; text-transform: uppercase;
    }
    .recon-badge--pending { background: #fef3c7; color: #b45309; }
    .recon-badge--matched { background: #dcfce7; color: #15803d; }

    /* Footer */
    .recon-footer {
        display: flex; align-items: center; gap: 24px;
        padding: 0 24px; background: #f8fafc;
        border-top: 1px solid #e2e8f0; height: 36px;
        font-size: 12px; color: #94a3b8; box-sizing: border-box;
    }
    .recon-footer-dot {
        display: inline-block; width: 8px; height: 8px; border-radius: 50%;
        margin-right: 6px; vertical-align: middle;
    }
    .recon-footer-dot--green { background: #22c55e; }
    .recon-footer-dot--blue { background: #3b82f6; }
    .recon-footer-spacer { flex: 1; }

    /* Button overrides */
    .recon-btn-auto .z-button { border: 1px solid #3b82f6; color: #3b82f6; background: #fff; border-radius: 6px; }
    .recon-btn-auto .z-button:hover { background: #eff6ff; }
    .recon-btn-finalize .z-button { background: #3b82f6; color: #fff; border: none; border-radius: 6px; }
    .recon-btn-finalize .z-button:hover { background: #2563eb; }
    .recon-btn-adjust .z-button { border: 1px solid #e2e8f0; color: #334155; background: #fff; border-radius: 6px; }
</style>
<window id="reconWin" hflex="1" vflex="1" sclass="recon-page"
        apply="zwriter.BankReconciliationComposer">
    <borderlayout hflex="1" vflex="1">
        <!-- ==================== HEADER ==================== -->
        <north border="none" height="56px">
            <n:div class="recon-header">
                <n:div class="recon-header-left">
                    <n:div class="recon-logo">
                        FinCore <n:span class="recon-logo-accent">Recon</n:span>
                    </n:div>
                    <n:nav class="recon-nav">
                        <n:a class="recon-nav-item" href="#">Dashboard</n:a>
                        <n:a class="recon-nav-item recon-nav-item--active" href="#">Reconciliation</n:a>
                        <n:a class="recon-nav-item" href="#">Reporting</n:a>
                        <n:a class="recon-nav-item" href="#">Audit Logs</n:a>
                    </n:nav>
                </n:div>
                <n:div class="recon-user">
                    <n:div class="recon-avatar">SJ</n:div>
                    <n:span>Sarah Jenkins</n:span>
                </n:div>
            </n:div>
        </north>

        <!-- ==================== MAIN CONTENT ==================== -->
        <center border="none" autoscroll="true">
            <vlayout hflex="1" vflex="1">
                <!-- Summary Cards -->
                <n:div class="recon-summary">
                    <n:div class="recon-stat-card">
                        <n:div class="recon-stat-label">Statement Balance</n:div>
                        <n:div class="recon-stat-value">
                            $1,422,904.55 <n:span class="recon-stat-currency">USD</n:span>
                        </n:div>
                    </n:div>
                    <n:div class="recon-stat-card">
                        <n:div class="recon-stat-label">Book Balance</n:div>
                        <n:div class="recon-stat-value">
                            $1,418,250.20 <n:span class="recon-stat-currency">USD</n:span>
                        </n:div>
                    </n:div>
                    <n:div class="recon-stat-card">
                        <n:div class="recon-stat-label recon-stat-label--warn">Unreconciled Difference</n:div>
                        <n:div class="recon-stat-value recon-stat-value--warn">
                            $4,654.35 <n:span class="recon-stat-currency">±</n:span>
                        </n:div>
                    </n:div>
                    <n:div class="recon-summary-actions">
                        <n:div class="recon-btn-auto">
                            <button id="autoMatchBtn" label="Auto-match" iconSclass="z-icon-magic"/>
                        </n:div>
                        <n:div class="recon-btn-finalize">
                            <button id="finalizeBtn" label="Finalize"/>
                        </n:div>
                        <n:div class="recon-progress">
                            <n:div>Matches: 192/184</n:div>
                            <n:div><n:span class="recon-progress-pct">96%</n:span> Complete</n:div>
                        </n:div>
                    </n:div>
                </n:div>

                <!-- Transaction Tabs + Table -->
                <n:div class="recon-content" >
                    <tabbox id="txnTabbox" >
                        <tabs>
                            <tab id="tabUnreconciled" label="Unreconciled (16)" selected="true"/>
                            <tab id="tabReconciled" label="Reconciled (163)"/>
                            <tab id="tabAll" label="All Transactions"/>
                        </tabs>
                        <tabpanels>
                            <!-- Unreconciled Tab -->
                            <tabpanel>
                                <vlayout hflex="1" >
                                    <!-- Filter bar -->
                                    <hlayout sclass="recon-filter-bar" hflex="1">
                                        <textbox id="searchBox" hflex="1"
                                                 placeholder="Search by reference, amount..."/>
                                        <button id="filterBtn" iconSclass="z-icon-filter"/>
                                        <button id="sortBtn" iconSclass="z-icon-sort-amount-asc"/>
                                        <n:div class="recon-btn-adjust">
                                            <button id="adjustmentBtn" label="Adjustment"/>
                                        </n:div>
                                    </hlayout>

                                    <!-- Transaction List -->
                                    <listbox id="txnListbox" hflex="1"
                                             mold="paging" pageSize="8"
                                             checkmark="true" multiple="true"
                                             emptyMessage="No unreconciled transactions">
                                        <listhead>
                                            <listheader label="Date" width="100px"/>
                                            <listheader label="Description" hflex="3"/>
                                            <listheader label="Ref" width="120px"/>
                                            <listheader label="Amount ($)" width="120px" align="right"/>
                                            <listheader label="Credit ($)" width="110px" align="right"/>
                                            <listheader label="Debit ($)" width="110px" align="right"/>
                                            <listheader label="Status" width="110px" align="center"/>
                                            <listheader label="" width="60px" align="center"/>
                                        </listhead>
                                        <!-- Rows populated by BankReconciliationComposer -->
                                    </listbox>
                                </vlayout>
                            </tabpanel>

                            <!-- Reconciled Tab -->
                            <tabpanel>
                                <vlayout hflex="1" vflex="1">
                                    <hlayout sclass="recon-filter-bar" hflex="1">
                                        <textbox id="searchBoxReconciled" hflex="1"
                                                 placeholder="Search reconciled transactions..."/>
                                        <button iconSclass="z-icon-filter"/>
                                    </hlayout>
                                    <listbox id="reconciledListbox" hflex="1" vflex="1"
                                             mold="paging" pageSize="8"
                                             emptyMessage="No reconciled transactions">
                                        <listhead>
                                            <listheader label="Date" width="100px"/>
                                            <listheader label="Description" hflex="3"/>
                                            <listheader label="Ref" width="120px"/>
                                            <listheader label="Amount ($)" width="120px" align="right"/>
                                            <listheader label="Credit ($)" width="110px" align="right"/>
                                            <listheader label="Debit ($)" width="110px" align="right"/>
                                            <listheader label="Status" width="110px" align="center"/>
                                            <listheader label="" width="60px" align="center"/>
                                        </listhead>
                                    </listbox>
                                </vlayout>
                            </tabpanel>

                            <!-- All Transactions Tab -->
                            <tabpanel>
                                <vlayout hflex="1" vflex="1">
                                    <hlayout sclass="recon-filter-bar" hflex="1">
                                        <textbox id="searchBoxAll" hflex="1"
                                                 placeholder="Search all transactions..."/>
                                        <button iconSclass="z-icon-filter"/>
                                    </hlayout>
                                    <listbox id="allTxnListbox" hflex="1" vflex="1"
                                             mold="paging" pageSize="8"
                                             emptyMessage="No transactions found">
                                        <listhead>
                                            <listheader label="Date" width="100px"/>
                                            <listheader label="Description" hflex="3"/>
                                            <listheader label="Ref" width="120px"/>
                                            <listheader label="Amount ($)" width="120px" align="right"/>
                                            <listheader label="Credit ($)" width="110px" align="right"/>
                                            <listheader label="Debit ($)" width="110px" align="right"/>
                                            <listheader label="Status" width="110px" align="center"/>
                                            <listheader label="" width="60px" align="center"/>
                                        </listhead>
                                    </listbox>
                                </vlayout>
                            </tabpanel>
                        </tabpanels>
                    </tabbox>
                </n:div>

                <!-- Footer Status Bar -->
                <n:div class="recon-footer">
                    <n:span>
                        <n:span class="recon-footer-dot recon-footer-dot--green"></n:span>
                        BANK SERVER CONNECTED
                    </n:span>
                    <n:span>
                        <n:span class="recon-footer-dot recon-footer-dot--blue"></n:span>
                        LAST LEDGER SYNCED
                    </n:span>
                    <n:span class="recon-footer-spacer"></n:span>
                    <n:span>SYSTEM V5.1 | ENTROPY CORE</n:span>
                </n:div>
            </vlayout>
        </center>
    </borderlayout>
</window>
</zk>