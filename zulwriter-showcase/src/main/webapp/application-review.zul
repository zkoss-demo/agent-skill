<?page title="GovPortal — Application Review"?>
<zk>
    <style>
    /* ===== Page shell ===== */
    .ar-page{
        background-color: #f7f9fc;
        font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #0f172a;
    }
    /* Labels take the page font. Deliberately NOT applied to .z-span: an icon span's
       font-family is the icon font, and overriding it draws every icon as an empty box. */
    .ar-page .z-label{
        font-family: inherit;
    }
    .ar-mono{
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    /* ===== Top bar ===== */
    .ar-topbar{
        display: flex;
        align-items: center;
        gap: 18px;
        background-color: #ffffff;
        border-bottom: 1px solid #e8eef5;
        padding: 14px 34px;
    }
    .ar-logo{
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background-color: #e6efff;
        color: #1f6feb;
        font-size: 18px;
        line-height: 42px;
        text-align: center;
    }
    .ar-brand-name{
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.015em;
        padding-right: 14px;
    }
    .ar-nav{
        display: flex;
        align-items: center;
        gap: 34px;
    }
    .ar-page a.ar-navlink{
        color: #475569;
        font-size: 17px;
        text-decoration: none;
    }
    .ar-page a.ar-navlink-on{
        color: #1f6feb;
        font-weight: 600;
    }
    .ar-searchwrap{
        display: flex;
        align-items: center;
        gap: 12px;
        margin-left: auto;
        width: 400px;
        background-color: #f4f7fb;
        border-radius: 11px;
        padding: 0 16px;
    }
    .ar-search-icon{ color: #94a3b8; font-size: 15px; }
    .ar-page input.ar-search{
        flex: 1;
        border: 0 none;
        background-color: transparent;
        box-shadow: none;
        padding: 13px 0;
        font-size: 16px;
        color: #0f172a;
    }
    .ar-bellwrap{ position: relative; }
    .ar-bell{ color: #64748b; font-size: 19px; }
    .ar-bell-dot{
        position: absolute;
        top: -2px;
        right: -3px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background-color: #ef4444;
    }
    .ar-avatar{
        width: 42px;
        height: 42px;
        border-radius: 21px;
        background-color: #e2d3c4;
        color: #7c5b3b;
        font-size: 17px;
        line-height: 42px;
        text-align: center;
    }

    /* ===== Centred content column ===== */
    .ar-container{
        max-width: 1240px;
        margin: 0 auto;
        padding: 30px 0 40px 0;
    }
    .ar-crumbs{
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 22px;
    }
    .ar-page a.ar-crumb{
        color: #64748b;
        font-size: 16px;
        text-decoration: none;
    }
    .ar-crumb-sep{ color: #cbd5e1; font-size: 15px; }
    .ar-crumb-now{ font-size: 16px; color: #334155; }

    /* ===== Success banner ===== */
    .ar-banner{
        display: flex;
        align-items: center;
        gap: 22px;
        background-color: #eefbf3;
        border: 1px solid #d3f0de;
        border-radius: 14px;
        padding: 26px 30px;
        margin-bottom: 30px;
    }
    .ar-banner-icon{
        width: 46px;
        height: 46px;
        border-radius: 23px;
        background-color: #d5f2e0;
        color: #12855a;
        font-size: 20px;
        line-height: 46px;
        text-align: center;
    }
    .ar-banner-title{
        display: block;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .ar-banner-refrow{
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 10px;
    }
    .ar-banner-reflabel{ font-size: 17px; color: #475569; }
    .ar-refchip{
        background-color: #e6ecf2;
        border-radius: 6px;
        color: #1e293b;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.03em;
        padding: 5px 10px;
    }
    .ar-page button.ar-btn-primary{
        background-color: #1f6feb;
        background-image: none;
        border: 0 none;
        border-radius: 10px;
        color: #ffffff;
        font-size: 17px;
        font-weight: 600;
        margin-left: auto;
        padding: 16px 28px;
    }

    /* ===== Summary card ===== */
    .ar-card{
        background-color: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
    }
    .ar-card-head{
        display: flex;
        align-items: center;
        border-bottom: 1px solid #eef2f7;
        padding: 26px 30px 24px 30px;
    }
    .ar-card-title{
        display: block;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.015em;
    }
    .ar-card-sub{
        display: block;
        font-size: 16px;
        color: #64748b;
        padding-top: 8px;
    }
    .ar-statechip{
        background-color: #e6effd;
        border-radius: 6px;
        color: #1f6feb;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.09em;
        margin-left: auto;
        padding: 6px 12px;
    }

    /* ===== Field sections ===== */
    .ar-section{ padding: 28px 30px 6px 30px; }
    .ar-section-div{
        border-top: 1px solid #f1f5f9;
        margin: 22px 30px 0 30px;
    }
    .ar-section-head{
        display: flex;
        align-items: center;
        gap: 11px;
        padding-bottom: 24px;
    }
    .ar-section-icon{ color: #1f6feb; font-size: 15px; }
    .ar-section-title{
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.11em;
        color: #1f6feb;
    }
    /* Three field blocks across, as the design lays them out. hflex cannot express a
       three-column grid whose rows wrap, so the columns live in the class. */
    .ar-fieldgrid{
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px 40px;
        padding-bottom: 22px;
    }
    .ar-fieldlabel{
        display: block;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: #94a3b8;
        padding-bottom: 10px;
    }
    .ar-fieldvalue{
        display: block;
        font-size: 19px;
        color: #1e293b;
        line-height: 1.45;
    }
    .ar-priorityrow{
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .ar-priority-dot{
        width: 9px;
        height: 9px;
        border-radius: 5px;
        background-color: #ef4444;
    }
    .ar-priority-value{
        font-size: 19px;
        font-weight: 600;
        color: #1e293b;
    }

    /* ===== Card footer ===== */
    .ar-card-foot{
        display: flex;
        align-items: center;
        gap: 14px;
        background-color: #fafbfd;
        border-top: 1px solid #eef2f7;
        border-radius: 0 0 14px 14px;
        padding: 22px 30px;
    }
    .ar-page button.ar-btn-ghost{
        background-color: #ffffff;
        background-image: none;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: #334155;
        font-size: 17px;
        font-weight: 500;
        padding: 15px 24px;
    }
    .ar-page button.ar-btn-dark{
        background-color: #0f172a;
        background-image: none;
        border: 0 none;
        border-radius: 10px;
        color: #ffffff;
        font-size: 17px;
        font-weight: 600;
        margin-left: auto;
        padding: 15px 28px;
    }

    /* ===== Page footer ===== */
    .ar-footer{
        display: flex;
        align-items: center;
        gap: 30px;
        max-width: 1240px;
        margin: 0 auto;
        padding: 10px 0 34px 0;
    }
    .ar-foot-text{ font-size: 15px; color: #94a3b8; }
    .ar-footlinks{
        display: flex;
        align-items: center;
        gap: 30px;
        margin-left: auto;
    }
    .ar-page a.ar-footlink{
        color: #64748b;
        font-size: 15px;
        text-decoration: none;
    }
    </style>

    <div apply="zwriter.ApplicationReviewComposer" sclass="ar-page" hflex="1" vflex="1">

        <!-- ===== Top bar ===== -->
        <div sclass="ar-topbar" hflex="1">
            <div sclass="ar-logo z-icon-university"/>
            <label value="GovPortal" sclass="ar-brand-name"/>
            <div sclass="ar-nav">
                <a label="Dashboard" sclass="ar-navlink"/>
                <a label="Applications" sclass="ar-navlink ar-navlink-on"/>
                <a label="Documents" sclass="ar-navlink"/>
                <a label="Settings" sclass="ar-navlink"/>
            </div>
            <div sclass="ar-searchwrap">
                <span sclass="z-icon-search ar-search-icon"/>
                <textbox id="searchBox" placeholder="Search applications..." sclass="ar-search"/>
            </div>
            <div sclass="ar-bellwrap">
                <span sclass="z-icon-bell ar-bell"/>
                <div sclass="ar-bell-dot"/>
            </div>
            <div sclass="ar-avatar z-icon-user"/>
        </div>

        <!-- ===== Centred content ===== -->
        <div sclass="ar-container">

            <div sclass="ar-crumbs">
                <a label="Applications" sclass="ar-crumb"/>
                <label value="/" sclass="ar-crumb-sep"/>
                <label id="crumbCurrent" sclass="ar-crumb-now"/>
            </div>

            <!-- ===== Submission banner ===== -->
            <div sclass="ar-banner" hflex="1">
                <div sclass="ar-banner-icon z-icon-check"/>
                <vlayout spacing="0">
                    <label id="bannerTitle" sclass="ar-banner-title"/>
                    <div sclass="ar-banner-refrow">
                        <label value="Reference Number:" sclass="ar-banner-reflabel"/>
                        <label id="referenceChip" sclass="ar-refchip ar-mono"/>
                    </div>
                </vlayout>
                <button id="trackBtn" label="Track Progress" iconSclass="z-icon-eye"
                        sclass="ar-btn-primary"/>
            </div>

            <!-- ===== Application summary ===== -->
            <div sclass="ar-card" hflex="1">
                <div sclass="ar-card-head" hflex="1">
                    <vlayout spacing="0">
                        <label value="Application Summary" sclass="ar-card-title"/>
                        <label id="summaryVariant" sclass="ar-card-sub"/>
                    </vlayout>
                    <label id="reviewState" sclass="ar-statechip"/>
                </div>

                <div sclass="ar-section" hflex="1">
                    <div sclass="ar-section-head">
                        <span sclass="z-icon-user ar-section-icon"/>
                        <label value="PERSONAL INFORMATION" sclass="ar-section-title"/>
                    </div>
                    <div sclass="ar-fieldgrid" hflex="1">
                        <div>
                            <label value="FULL NAME" sclass="ar-fieldlabel"/>
                            <label id="fullName" sclass="ar-fieldvalue"/>
                        </div>
                        <div>
                            <label value="DATE OF BIRTH" sclass="ar-fieldlabel"/>
                            <label id="dateOfBirth" sclass="ar-fieldvalue"/>
                        </div>
                        <div>
                            <label value="RESIDENTIAL ADDRESS" sclass="ar-fieldlabel"/>
                            <label id="address" sclass="ar-fieldvalue"/>
                        </div>
                    </div>
                </div>

                <div sclass="ar-section-div"/>

                <div sclass="ar-section" hflex="1">
                    <div sclass="ar-section-head">
                        <span sclass="z-icon-file-text-o ar-section-icon"/>
                        <label value="APPLICATION DETAILS" sclass="ar-section-title"/>
                    </div>
                    <div sclass="ar-fieldgrid" hflex="1">
                        <div>
                            <label value="APPLICATION TYPE" sclass="ar-fieldlabel"/>
                            <label id="applicationType" sclass="ar-fieldvalue"/>
                        </div>
                        <div>
                            <label value="SUBMISSION DATE" sclass="ar-fieldlabel"/>
                            <label id="submissionDate" sclass="ar-fieldvalue"/>
                        </div>
                        <div>
                            <label value="PRIORITY LEVEL" sclass="ar-fieldlabel"/>
                            <div sclass="ar-priorityrow">
                                <div sclass="ar-priority-dot"/>
                                <label id="priorityLevel" sclass="ar-priority-value"/>
                            </div>
                        </div>
                        <div>
                            <label value="REVIEWING OFFICE" sclass="ar-fieldlabel"/>
                            <label id="reviewingOffice" sclass="ar-fieldvalue"/>
                        </div>
                        <div>
                            <label value="VERIFICATION ID" sclass="ar-fieldlabel"/>
                            <label id="verificationId" sclass="ar-fieldvalue"/>
                        </div>
                    </div>
                </div>

                <div sclass="ar-card-foot" hflex="1">
                    <button id="printBtn" label="Print Summary" iconSclass="z-icon-print"
                            sclass="ar-btn-ghost"/>
                    <button id="pdfBtn" label="Download PDF" iconSclass="z-icon-file-pdf-o"
                            sclass="ar-btn-ghost"/>
                    <button id="homeBtn" label="Return to Home" iconSclass="z-icon-home"
                            sclass="ar-btn-dark"/>
                </div>
            </div>
        </div>

        <!-- ===== Footer ===== -->
        <div sclass="ar-footer" hflex="1">
            <label id="copyright" sclass="ar-foot-text"/>
            <div sclass="ar-footlinks">
                <a label="Privacy Policy" sclass="ar-footlink"/>
                <a label="Terms of Service" sclass="ar-footlink"/>
                <a label="Contact Support" sclass="ar-footlink"/>
            </div>
        </div>
    </div>
</zk>
