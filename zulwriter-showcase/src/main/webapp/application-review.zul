<?page title="Application Review | GovPortal"?>
<zk>
	<style>
		.gp-page { background: #f4f6f9; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #16202c; }
		.gp-shell { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

		/* --- top navigation --- */
		.gp-nav { background: #fff; border-bottom: 1px solid #e6eaf0; padding: 14px 0; }
		.gp-page .gp-flex-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
		.gp-page .gp-nav-link, .gp-page .gp-footer-link, .gp-brand-name,
		.gp-crumb-current, .gp-field-value, .gp-page button.gp-btn { white-space: nowrap; }
		.gp-page .gp-logo { width: 34px; height: 34px; border-radius: 9px; background: #e8f1fe; color: #1877f2;
			display: inline-flex; align-items: center; justify-content: center; font-size: 16px; }
		.gp-brand-name { font-size: 19px; font-weight: 700; }
		.gp-page a.gp-nav-link { color: #55637a; font-size: 15px; text-decoration: none; }
		.gp-page a.gp-nav-link-active { color: #1877f2; font-weight: 600; }
		.gp-search { position: relative; width: 320px; }
		.gp-page .gp-search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
			color: #9aa7b8; font-size: 14px; z-index: 1; }
		.gp-page input.gp-search-input { width: 100%; height: 42px; box-sizing: border-box; padding: 0 14px 0 40px;
			border: 1px solid #e2e7ee; border-radius: 10px; background: #f7f9fc; font-size: 14px; }
		.gp-page a.gp-icon-btn { color: #33415c; font-size: 17px; text-decoration: none; }
		.gp-page .gp-avatar { width: 34px; height: 34px; border-radius: 50%; background: #dfe5ee; color: #5a6a80;
			display: inline-flex; align-items: center; justify-content: center; font-size: 15px; }

		/* --- breadcrumb --- */
		.gp-crumbs { padding: 20px 0 4px; }
		.gp-page a.gp-crumb-link { color: #5b6b82; font-size: 14px; text-decoration: none; }
		.gp-crumb-sep { color: #a7b2c2; font-size: 14px; }
		.gp-crumb-current { color: #16202c; font-size: 14px; }

		/* --- success banner --- */
		.gp-banner { background: #ecfaf1; border: 1px solid #cfeddc; border-radius: 12px; padding: 22px 26px; margin-top: 14px; }
		.gp-page .gp-banner-icon { width: 40px; height: 40px; border-radius: 50%; background: #d6f2e0; color: #12a150;
			display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }
		.gp-banner-title { font-size: 25px; font-weight: 700; }
		.gp-banner-sub { color: #55637a; font-size: 14px; }
		.gp-page .gp-chip { background: #dcecf6; border-radius: 6px; padding: 3px 9px; font-family: monospace;
			font-size: 13px; font-weight: 600; letter-spacing: .5px; }

		/* --- summary card --- */
		.gp-card { background: #fff; border: 1px solid #e6eaf0; border-radius: 12px; margin: 28px 0; }
		.gp-card-head { padding: 24px 30px; border-bottom: 1px solid #eef1f5; }
		.gp-card-title { font-size: 20px; font-weight: 700; }
		.gp-card-subtitle { color: #6b7a8d; font-size: 14px; }
		.gp-page .gp-badge { background: #e6f0fd; color: #1a6fd4; border-radius: 6px; padding: 5px 11px;
			font-size: 11px; font-weight: 700; letter-spacing: .8px; }
		.gp-card-body { padding: 28px 30px 30px; }
		.gp-hr { border-top: 1px solid #eef1f5; margin: 26px 0; }
		.gp-section-head { margin-bottom: 20px; }
		.gp-page .gp-section-icon { color: #1877f2; font-size: 14px; }
		.gp-section-title { color: #1877f2; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
		.gp-fieldrow { margin-bottom: 22px; }
		.gp-field-label { color: #8794a6; font-size: 11px; font-weight: 700; letter-spacing: .9px; }
		.gp-field-value { font-size: 15px; min-height: 20px; display: inline-block; }
		.gp-field-value-strong { font-weight: 600; }
		.gp-page .gp-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
		.gp-page .gp-dot-high { background: #ef4444; }
		.gp-page .gp-dot-normal { background: #f59e0b; }
		.gp-page .gp-dot-low { background: #10b981; }
		.gp-card-foot { background: #f8fafc; border-top: 1px solid #eef1f5; border-radius: 0 0 12px 12px; padding: 18px 30px; }

		/* --- buttons --- */
		.gp-page button.gp-btn { height: 44px; padding: 0 20px; border-radius: 9px; font-size: 15px; font-weight: 600;
			background-image: none; box-shadow: none; cursor: pointer; }
		.gp-page button.gp-btn-primary { background: #1877f2; border: 1px solid #1877f2; color: #fff; }
		.gp-page button.gp-btn-ghost { background: #fff; border: 1px solid #dde3ec; color: #24324a; }
		.gp-page button.gp-btn-dark { background: #101b2d; border: 1px solid #101b2d; color: #fff; }

		/* --- page footer --- */
		.gp-footer { border-top: 1px solid #e6eaf0; padding: 22px 0 30px; }
		.gp-footer-text { color: #77859a; font-size: 13px; }
		.gp-page a.gp-footer-link { color: #77859a; font-size: 13px; text-decoration: none; }
	</style>

	<div sclass="gp-page" hflex="1" vflex="1" apply="zwriter.ApplicationReviewComposer">

		<!-- top navigation -->
		<div sclass="gp-nav">
			<div sclass="gp-shell gp-flex-row">
				<hlayout valign="middle" spacing="34px">
						<hlayout valign="middle" spacing="11px">
						<span sclass="gp-logo z-icon-university"/>
						<label value="GovPortal" sclass="gp-brand-name"/>
					</hlayout>
					<hlayout valign="middle" spacing="30px">
						<a label="Dashboard" sclass="gp-nav-link"/>
						<a label="Applications" sclass="gp-nav-link gp-nav-link-active"/>
						<a label="Documents" sclass="gp-nav-link"/>
						<a label="Settings" sclass="gp-nav-link"/>
					</hlayout>
				</hlayout>
				<hlayout valign="middle" spacing="20px">
					<div sclass="gp-search">
						<span sclass="gp-search-icon z-icon-search"/>
						<textbox id="searchBox" sclass="gp-search-input" placeholder="Search applications..."/>
					</div>
					<a id="notificationsBtn" iconSclass="z-icon-bell" sclass="gp-icon-btn" tooltiptext="Notifications"/>
					<span sclass="gp-avatar z-icon-user"/>
				</hlayout>
			</div>
		</div>

		<div sclass="gp-shell">

			<!-- breadcrumb -->
			<hlayout sclass="gp-crumbs" valign="middle" spacing="9px">
				<a label="Applications" sclass="gp-crumb-link"/>
				<label value="/" sclass="gp-crumb-sep"/>
				<label id="breadcrumbCurrent" sclass="gp-crumb-current"/>
			</hlayout>

			<!-- submission confirmation banner -->
			<div sclass="gp-banner">
				<hlayout valign="middle" spacing="18px" hflex="1">
					<span sclass="gp-banner-icon z-icon-check-circle"/>
					<vlayout spacing="6px" hflex="1">
						<label value="Application Submitted Successfully" sclass="gp-banner-title"/>
						<hlayout valign="middle" spacing="10px">
							<label value="Reference Number:" sclass="gp-banner-sub"/>
							<label id="referenceChip" sclass="gp-chip"/>
						</hlayout>
					</vlayout>
					<button id="trackProgressBtn" label="Track Progress" iconSclass="z-icon-eye"
							sclass="gp-btn gp-btn-primary"/>
				</hlayout>
			</div>

			<!-- application summary card -->
			<div sclass="gp-card">
				<div sclass="gp-card-head">
					<hlayout valign="middle" hflex="1">
						<vlayout spacing="5px" hflex="1">
							<label value="Application Summary" sclass="gp-card-title"/>
							<label value="Variant 1: Comprehensive Detail View" sclass="gp-card-subtitle"/>
						</vlayout>
						<label id="statusBadge" sclass="gp-badge"/>
					</hlayout>
				</div>

				<div sclass="gp-card-body">
					<hlayout sclass="gp-section-head" valign="middle" spacing="9px">
						<span sclass="gp-section-icon z-icon-user"/>
						<label value="PERSONAL INFORMATION" sclass="gp-section-title"/>
					</hlayout>
					<hlayout sclass="gp-fieldrow" valign="top" hflex="1" spacing="24px">
						<vlayout hflex="1" spacing="7px">
							<label value="FULL NAME" sclass="gp-field-label"/>
							<label id="fullName" sclass="gp-field-value"/>
						</vlayout>
						<vlayout hflex="1" spacing="7px">
							<label value="DATE OF BIRTH" sclass="gp-field-label"/>
							<label id="dateOfBirth" sclass="gp-field-value"/>
						</vlayout>
						<vlayout hflex="1" spacing="7px">
							<label value="RESIDENTIAL ADDRESS" sclass="gp-field-label"/>
							<label id="residentialAddress" sclass="gp-field-value"/>
						</vlayout>
					</hlayout>

					<div sclass="gp-hr"/>

					<hlayout sclass="gp-section-head" valign="middle" spacing="9px">
						<span sclass="gp-section-icon z-icon-file-alt"/>
						<label value="APPLICATION DETAILS" sclass="gp-section-title"/>
					</hlayout>
					<hlayout sclass="gp-fieldrow" valign="top" hflex="1" spacing="24px">
						<vlayout hflex="1" spacing="7px">
							<label value="APPLICATION TYPE" sclass="gp-field-label"/>
							<label id="applicationType" sclass="gp-field-value"/>
						</vlayout>
						<vlayout hflex="1" spacing="7px">
							<label value="SUBMISSION DATE" sclass="gp-field-label"/>
							<label id="submissionDate" sclass="gp-field-value"/>
						</vlayout>
						<vlayout hflex="1" spacing="7px">
							<label value="PRIORITY LEVEL" sclass="gp-field-label"/>
							<hlayout valign="middle" spacing="9px">
								<span id="priorityDot" sclass="gp-dot"/>
								<label id="priorityLevel" sclass="gp-field-value gp-field-value-strong"/>
							</hlayout>
						</vlayout>
					</hlayout>
					<hlayout sclass="gp-fieldrow" valign="top" hflex="1" spacing="24px">
						<vlayout hflex="1" spacing="7px">
							<label value="REVIEWING OFFICE" sclass="gp-field-label"/>
							<label id="reviewingOffice" sclass="gp-field-value"/>
						</vlayout>
						<vlayout hflex="1" spacing="7px">
							<label value="VERIFICATION ID" sclass="gp-field-label"/>
							<label id="verificationId" sclass="gp-field-value"/>
						</vlayout>
						<div hflex="1"/>
					</hlayout>
				</div>

				<div sclass="gp-card-foot gp-flex-row">
					<hlayout valign="middle" spacing="13px">
						<button id="printBtn" label="Print Summary" iconSclass="z-icon-print"
								sclass="gp-btn gp-btn-ghost"/>
						<button id="downloadPdfBtn" label="Download PDF" iconSclass="z-icon-file-pdf"
								sclass="gp-btn gp-btn-ghost"/>
					</hlayout>
					<button id="homeBtn" label="Return to Home" iconSclass="z-icon-home"
							sclass="gp-btn gp-btn-dark"/>
				</div>
			</div>

			<!-- page footer -->
			<div sclass="gp-footer gp-flex-row">
				<label value="© 2023 GovPortal Services. All rights reserved." sclass="gp-footer-text"/>
				<hlayout valign="middle" spacing="30px">
					<a label="Privacy Policy" sclass="gp-footer-link"/>
					<a label="Terms of Service" sclass="gp-footer-link"/>
					<a label="Contact Support" sclass="gp-footer-link"/>
				</hlayout>
			</div>
		</div>
	</div>
</zk>
