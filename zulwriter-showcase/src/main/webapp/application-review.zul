<?xml version="1.0" encoding="UTF-8"?>
<?page title="Application Review - GovPortal"?>
<!-- Generated from: ui-screenshots/Application Review.png -->
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:n="native">

    <style><![CDATA[
        /* === Base === */
        .gov-page {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: #f3f4f6;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* === Navbar === */
        .gov-navbar {
            background: white;
            border-bottom: 1px solid #e5e7eb;
            padding: 0 24px;
            display: flex;
            align-items: center;
            height: 60px;
            gap: 32px;
        }
        .nav-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 700;
            color: #1f2937;
        }
        .nav-brand-icon {
            color: #3b82f6;
            font-size: 22px;
        }
        .nav-links {
            display: flex;
            gap: 4px;
            flex: 1;
        }
        .nav-link {
            padding: 6px 12px;
            border-radius: 6px;
            color: #6b7280;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }
        .nav-link:hover { color: #1f2937; background: #f9fafb; }
        .nav-link.active { color: #3b82f6; }
        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .nav-icon-btn .z-button {
            background: none;
            border: none;
            color: #6b7280;
            font-size: 18px;
            cursor: pointer;
        }
        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #374151;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 600;
        }

        /* === Content === */
        .gov-content {
            flex: 1;
            max-width: 900px;
            width: 100%;
            margin: 0 auto;
            padding: 28px 16px;
            box-sizing: border-box;
        }

        /* === Breadcrumb === */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 20px;
        }
        .breadcrumb-link {
            color: #6b7280;
            text-decoration: none;
        }
        .breadcrumb-link:hover { color: #3b82f6; }
        .breadcrumb-sep { color: #d1d5db; }
        .breadcrumb-current { color: #374151; }

        /* === Success Banner === */
        .success-banner {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 12px;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }
        .success-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .success-icon-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #22c55e;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .success-title {
            font-size: 18px;
            font-weight: 700;
            color: #14532d;
            margin: 0 0 4px 0;
        }
        .success-ref {
            font-size: 13px;
            color: #166534;
            margin: 0;
        }
        .ref-badge {
            background: #dcfce7;
            border: 1px solid #86efac;
            color: #15803d;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 12px;
        }
        .btn-track-progress .z-button {
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-track-progress .z-button:hover { background: #2563eb; }

        /* === Application Card === */
        .app-card {
            background: white;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 1px 4px rgba(0,0,0,0.07);
            padding: 24px;
            margin-bottom: 20px;
        }
        .card-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }
        .card-title {
            font-size: 18px;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }
        .card-subtitle {
            font-size: 13px;
            color: #9ca3af;
            margin: 4px 0 0 0;
        }
        .badge-finalized {
            background: #eff6ff;
            color: #3b82f6;
            border: 1px solid #bfdbfe;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .card-divider {
            border: none;
            border-top: 1px solid #f3f4f6;
            margin: 20px 0;
        }

        /* === Section Headers === */
        .section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }
        .section-icon {
            color: #3b82f6;
            font-size: 14px;
        }
        .section-label {
            font-size: 11px;
            font-weight: 700;
            color: #3b82f6;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        /* === Detail Grids === */
        .detail-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        .detail-grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .detail-label {
            font-size: 10px;
            font-weight: 600;
            color: #9ca3af;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }
        .detail-value {
            font-size: 14px;
            color: #111827;
            font-weight: 500;
            line-height: 1.4;
        }
        .priority-high {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }
        .priority-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ef4444;
            display: inline-block;
            flex-shrink: 0;
        }

        /* === Action Buttons === */
        .action-buttons {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-outline .z-button {
            background: white;
            border: 1px solid #d1d5db;
            color: #374151;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-outline .z-button:hover { background: #f9fafb; }
        .btn-primary-dark .z-button {
            background: #111827;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-primary-dark .z-button:hover { background: #1f2937; }

        /* === Footer === */
        .gov-footer {
            background: white;
            border-top: 1px solid #e5e7eb;
            padding: 16px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: #9ca3af;
        }
        .footer-links {
            display: flex;
            gap: 20px;
        }
        .footer-link {
            color: #9ca3af;
            text-decoration: none;
        }
        .footer-link:hover { color: #374151; }
    ]]></style>

    <div apply="zwriter.ApplicationReviewComposer" sclass="gov-page">

        <!-- Navigation Header -->
        <n:header class="gov-navbar">
            <n:div class="nav-brand">
                <n:span class="z-icon-building nav-brand-icon"/>
                <n:span>GovPortal</n:span>
            </n:div>
            <n:nav class="nav-links">
                <n:a href="#" class="nav-link">Dashboard</n:a>
                <n:a href="#" class="nav-link active">Applications</n:a>
                <n:a href="#" class="nav-link">Documents</n:a>
                <n:a href="#" class="nav-link">Settings</n:a>
            </n:nav>
            <n:div class="nav-right">
                <textbox id="searchBox" placeholder="Search applications..." width="200px"/>
                <button id="bellBtn" iconSclass="z-icon-bell" sclass="nav-icon-btn"/>
                <n:div class="user-avatar">JD</n:div>
            </n:div>
        </n:header>

        <!-- Main Content -->
        <n:main class="gov-content">

            <!-- Breadcrumb -->
            <n:nav class="breadcrumb">
                <n:a href="#" class="breadcrumb-link">Applications</n:a>
                <n:span class="breadcrumb-sep"> / </n:span>
                <n:span class="breadcrumb-current">Review REF-2023-0892</n:span>
            </n:nav>

            <!-- Success Banner -->
            <n:div class="success-banner">
                <n:div class="success-left">
                    <n:div class="success-icon-circle">
                        <n:span class="z-icon-check"/>
                    </n:div>
                    <n:div>
                        <n:h2 class="success-title">Application Submitted Successfully</n:h2>
                        <n:p class="success-ref">
                            Reference Number:&#160;<n:span class="ref-badge">REF-2023-0892</n:span>
                        </n:p>
                    </n:div>
                </n:div>
                <button id="trackProgressBtn" label="Track Progress" iconSclass="z-icon-eye" sclass="btn-track-progress"/>
            </n:div>

            <!-- Application Summary Card -->
            <n:div class="app-card">
                <!-- Card Header -->
                <n:div class="card-header-row">
                    <n:div>
                        <n:h3 class="card-title">Application Summary</n:h3>
                        <n:p class="card-subtitle">Variant 1: Comprehensive Detail View</n:p>
                    </n:div>
                    <n:span class="badge-finalized">FINALIZED</n:span>
                </n:div>

                <n:hr class="card-divider"/>

                <!-- Personal Information -->
                <n:div class="section-header">
                    <n:span class="z-icon-user section-icon"/>
                    <n:span class="section-label">Personal Information</n:span>
                </n:div>
                <n:div class="detail-grid-3">
                    <n:div class="detail-item">
                        <n:span class="detail-label">Full Name</n:span>
                        <n:span class="detail-value">John Quincy Doe</n:span>
                    </n:div>
                    <n:div class="detail-item">
                        <n:span class="detail-label">Date of Birth</n:span>
                        <n:span class="detail-value">January 15, 1985</n:span>
                    </n:div>
                    <n:div class="detail-item">
                        <n:span class="detail-label">Residential Address</n:span>
                        <n:span class="detail-value">123 Maple Avenue, Springfield, IL 62704</n:span>
                    </n:div>
                </n:div>

                <n:hr class="card-divider"/>

                <!-- Application Details -->
                <n:div class="section-header">
                    <n:span class="z-icon-file-alt section-icon"/>
                    <n:span class="section-label">Application Details</n:span>
                </n:div>
                <n:div class="detail-grid-3">
                    <n:div class="detail-item">
                        <n:span class="detail-label">Application Type</n:span>
                        <n:span class="detail-value">Corporate License Renewal</n:span>
                    </n:div>
                    <n:div class="detail-item">
                        <n:span class="detail-label">Submission Date</n:span>
                        <n:span class="detail-value">August 24, 2023 • 14:32 EST</n:span>
                    </n:div>
                    <n:div class="detail-item">
                        <n:span class="detail-label">Priority Level</n:span>
                        <n:span class="detail-value priority-high">
                            <n:span class="priority-dot"/>High Priority
                        </n:span>
                    </n:div>
                </n:div>
                <n:div class="detail-grid-2" style="margin-top: 20px">
                    <n:div class="detail-item">
                        <n:span class="detail-label">Reviewing Office</n:span>
                        <n:span class="detail-value">Dept. of Commerce Central</n:span>
                    </n:div>
                    <n:div class="detail-item">
                        <n:span class="detail-label">Verification ID</n:span>
                        <n:span class="detail-value">VID-00981-XYZ</n:span>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Action Buttons -->
            <n:div class="action-buttons">
                <button id="printBtn" label="Print Summary" iconSclass="z-icon-print" sclass="btn-outline"/>
                <button id="downloadBtn" label="Download PDF" iconSclass="z-icon-download" sclass="btn-outline"/>
                <space hflex="1"/>
                <button id="returnHomeBtn" label="Return to Home" iconSclass="z-icon-home" sclass="btn-primary-dark"/>
            </n:div>

        </n:main>

        <!-- Footer -->
        <n:footer class="gov-footer">
            <n:span>© 2023 GovPortal Services. All rights reserved.</n:span>
            <n:nav class="footer-links">
                <n:a href="#" class="footer-link">Privacy Policy</n:a>
                <n:a href="#" class="footer-link">Terms of Service</n:a>
                <n:a href="#" class="footer-link">Contact Support</n:a>
            </n:nav>
        </n:footer>

    </div>

</zk>
