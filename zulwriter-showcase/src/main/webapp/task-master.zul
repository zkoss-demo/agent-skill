<?page title="TaskMaster"?>
<zk xmlns:n="native">
    <style>
        html, body { height: 100%; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

        /* Sidebar */
        .sidebar {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: #1a1f2e;
            color: #fff;
            overflow: hidden;
        }
        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 16px 16px;
            border-bottom: 1px solid #2d3348;
        }
        .brand-icon {
            width: 36px; height: 36px;
            background: #3b5bdb;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }
        .brand-title { font-size: 16px; font-weight: 700; color: #fff; }
        .brand-sub { font-size: 10px; color: #8b93b0; letter-spacing: 0.5px; }

        .sidebar-nav { flex: 1; overflow-y: auto; padding: 8px 0; }
        .nav-section-label {
            padding: 12px 16px 4px;
            font-size: 10px; font-weight: 600;
            color: #8b93b0; letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Override ZK tree styles for sidebar nav */
        .sidebar-nav .z-tree { background: transparent; border: none; }
        .sidebar-nav .z-tree-body { background: transparent; }
        .sidebar-nav .z-treerow { background: transparent; }
        .sidebar-nav .z-treecell { color: #c4cad9; padding: 6px 16px; font-size: 13px; }
        .sidebar-nav .z-treecell:hover { background: #2d3348; color: #fff; border-radius: 6px; }
        .sidebar-nav .z-treeitem-selected > .z-treerow > .z-treecell {
            background: #2d3348; color: #fff; border-radius: 6px;
        }
        .sidebar-nav .z-tree-icon { color: #8b93b0; }

        .nav-item-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            color: #c4cad9;
            font-size: 13px;
            cursor: pointer;
            border-radius: 6px;
            margin: 1px 8px;
        }
        .nav-item-btn:hover { background: #2d3348; color: #fff; }
        .nav-item-btn .z-icon { font-size: 14px; color: #8b93b0; }

        .sidebar-footer { padding: 16px; border-top: 1px solid #2d3348; }
        .btn-new-project {
            width: 100%;
            background: #3b5bdb !important;
            color: #fff !important;
            border: none !important;
            border-radius: 8px !important;
            padding: 10px !important;
            font-size: 14px !important;
            font-weight: 600 !important;
            cursor: pointer;
        }
        .btn-new-project:hover { background: #2f4ac7 !important; }

        /* Header bar */
        .header-bar {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            background: #fff;
            border-bottom: 1px solid #e8eaf0;
            gap: 12px;
        }
        .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #8b93b0; }
        .breadcrumb a { color: #8b93b0; text-decoration: none; }
        .breadcrumb a:hover { color: #3b5bdb; }
        .breadcrumb .sep { color: #c4cad9; }
        .breadcrumb .current { color: #1a1f2e; font-weight: 500; }

        .header-spacer { flex: 1; }

        .search-box { border-radius: 20px !important; border: 1px solid #e8eaf0 !important; padding: 6px 12px !important; font-size: 13px !important; }
        .icon-btn { background: transparent !important; border: none !important; color: #8b93b0 !important; padding: 6px 8px !important; border-radius: 8px !important; }
        .icon-btn:hover { background: #f0f2f8 !important; color: #1a1f2e !important; }

        .user-info { display: flex; align-items: center; gap: 10px; }
        .user-name { font-size: 13px; font-weight: 600; color: #1a1f2e; text-align: right; }
        .user-role { font-size: 10px; color: #8b93b0; text-align: right; text-transform: uppercase; letter-spacing: 0.5px; }
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; background: #3b5bdb; }

        /* Content area */
        .content-area { padding: 24px; background: #f5f6fa; height: 100%; overflow-y: auto; box-sizing: border-box; }

        .content-header { display: flex; align-items: flex-start; margin-bottom: 20px; gap: 12px; }
        .content-header-left { flex: 1; }
        .page-title { font-size: 22px; font-weight: 700; color: #1a1f2e; display: block; }
        .page-subtitle { font-size: 13px; color: #8b93b0; display: block; margin-top: 2px; }

        .filter-toolbar-wrap { display: flex; align-items: center; gap: 8px; }
        .filter-btn {
            background: #fff !important; border: 1px solid #e8eaf0 !important;
            border-radius: 6px !important; padding: 6px 12px !important;
            font-size: 13px !important; color: #5a6178 !important; cursor: pointer;
        }
        .filter-btn:hover { border-color: #3b5bdb !important; color: #3b5bdb !important; }
        .filter-btn-active {
            background: #3b5bdb !important; color: #fff !important;
            border-color: #3b5bdb !important;
        }
        .sort-combo { border-radius: 6px !important; border: 1px solid #e8eaf0 !important; font-size: 13px !important; }

        /* Task cards grid */
        .task-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        .task-card {
            background: #fff;
            border-radius: 12px;
            padding: 16px;
            border: 1px solid #e8eaf0;
            display: flex; flex-direction: column; gap: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }
        .card-header { display: flex; align-items: center; justify-content: space-between; }
        .status-badge {
            font-size: 10px; font-weight: 700; padding: 3px 8px;
            border-radius: 4px; letter-spacing: 0.5px;
        }
        .status-badge.in-progress { background: #fff3cd; color: #b08000; }
        .status-badge.completed { background: #d4edda; color: #1a7a3a; }
        .status-badge.todo { background: #e3f0ff; color: #1a5bbf; }

        .card-menu-btn { background: transparent !important; border: none !important; color: #c4cad9 !important; padding: 2px 6px !important; }
        .card-menu-btn:hover { color: #5a6178 !important; }

        .card-title { font-size: 14px; font-weight: 600; color: #1a1f2e; line-height: 1.4; }
        .card-desc { font-size: 12px; color: #8b93b0; line-height: 1.5; flex: 1; }
        .card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }

        .priority-badge { font-size: 11px; font-weight: 600; }
        .priority-badge.high { color: #d9534f; }
        .priority-badge.medium { color: #3b5bdb; }
        .priority-badge.low { color: #8b93b0; }

        .assignees { display: flex; }
        .avatar { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #fff; margin-left: -6px; background: #c4cad9; object-fit: cover; }
        .assignees .avatar:first-child { margin-left: 0; }

        /* Create new task card */
        .create-card {
            border: 2px dashed #d0d5e8 !important;
            background: transparent !important;
            box-shadow: none !important;
            justify-content: center;
            align-items: center;
            min-height: 140px;
            cursor: pointer;
        }
        .create-card:hover { border-color: #3b5bdb !important; }
        .create-inner { display: flex; flex-direction: column; align-items: center; gap: 8px; color: #8b93b0; }
        .create-icon { font-size: 24px; color: #c4cad9; }
        .create-label { font-size: 13px; }
    </style>
<borderlayout height="100%"
              apply="zwriter.TaskMasterComposer">

    <west width="220px" border="none" style="overflow:hidden;">
        <n:div class="sidebar">
            <!-- Brand -->
            <n:div class="sidebar-brand">
                <n:div class="brand-icon">&#9783;</n:div>
                <n:div>
                    <n:div class="brand-title">TaskMaster</n:div>
                    <n:div class="brand-sub">ENTERPRISE V1.2</n:div>
                </n:div>
            </n:div>

            <!-- Navigation -->
            <n:div class="sidebar-nav">
                <toolbarbutton id="dashboardBtn" label="Dashboard"
                               iconSclass="z-icon-th-large" sclass="nav-item-btn"/>

                <n:div class="nav-section-label">WORKSPACES</n:div>

                <tree id="navTree" sclass="sidebar-nav" width="100%">
                    <treechildren>
                        <treeitem open="true">
                            <treerow>
                                <treecell label="Projects" iconSclass="z-icon-folder-open"/>
                            </treerow>
                            <treechildren>
                                <treeitem open="true">
                                    <treerow>
                                        <treecell label="Team Alpha" iconSclass="z-icon-users"/>
                                    </treerow>
                                    <treechildren>
                                        <treeitem id="sprint1Item" selected="true">
                                            <treerow>
                                                <treecell label="Sprint 1" iconSclass="z-icon-bolt"/>
                                            </treerow>
                                        </treeitem>
                                        <treeitem>
                                            <treerow>
                                                <treecell label="Sprint 2 (Next)" iconSclass="z-icon-history"/>
                                            </treerow>
                                        </treeitem>
                                    </treechildren>
                                </treeitem>
                                <treeitem>
                                    <treerow>
                                        <treecell label="Team Bravo" iconSclass="z-icon-users"/>
                                    </treerow>
                                </treeitem>
                            </treechildren>
                        </treeitem>
                    </treechildren>
                </tree>

                <toolbarbutton id="reportsBtn" label="Reports"
                               iconSclass="z-icon-bar-chart" sclass="nav-item-btn"/>
                <toolbarbutton id="settingsBtn" label="Settings"
                               iconSclass="z-icon-cog" sclass="nav-item-btn"/>
            </n:div>

            <!-- Footer -->
            <n:div class="sidebar-footer">
                <button id="newProjectBtn" label="+ New Project" sclass="btn-new-project" hflex="1"/>
            </n:div>
        </n:div>
    </west>

    <center border="none" style="background:#f5f6fa; overflow:hidden;">
        <vlayout vflex="1" hflex="1" style="height:100%;">

            <!-- Header bar -->
            <n:div class="header-bar">
                <n:nav class="breadcrumb">
                    <n:a href="#">Projects</n:a>
                    <n:span class="sep"> &#8250; </n:span>
                    <n:a href="#">Team Alpha</n:a>
                    <n:span class="sep"> &#8250; </n:span>
                    <n:span class="current">Sprint 1</n:span>
                </n:nav>
                <n:div class="header-spacer"/>
                <textbox id="searchBox" placeholder="Search tasks..." sclass="search-box" width="200px"/>
                <button id="notifBtn" iconSclass="z-icon-bell" sclass="icon-btn" tooltiptext="Notifications"/>
                <n:div class="user-info">
                    <n:div>
                        <n:div class="user-name">Alex Rivers</n:div>
                        <n:div class="user-role">Project Lead</n:div>
                    </n:div>
                    <n:img class="user-avatar" src="" alt="AR"/>
                </n:div>
            </n:div>

            <!-- Content -->
            <div sclass="content-area" vflex="1">

                <!-- Title + filter row -->
                <n:div class="content-header">
                    <n:div class="content-header-left">
                        <n:span class="page-title">Recent Tasks</n:span>
                        <n:span class="page-subtitle">Manage your active workload for the current sprint.</n:span>
                    </n:div>
                    <n:div class="filter-toolbar-wrap">
                        <button id="filterAllBtn"      label="Status: All" sclass="filter-btn filter-btn-active"/>
                        <button id="filterPriorityBtn" label="Priority"    sclass="filter-btn"/>
                        <button id="filterDueDateBtn"  label="Due Date"    sclass="filter-btn"/>
                        <combobox id="sortCombo" value="Sort: Newest" readonly="true" sclass="sort-combo" width="140px">
                            <comboitem label="Sort: Newest"/>
                            <comboitem label="Sort: Oldest"/>
                            <comboitem label="Sort: Priority"/>
                        </combobox>
                        <button id="advFilterBtn" iconSclass="z-icon-sliders" sclass="icon-btn" tooltiptext="Advanced filters"/>
                    </n:div>
                </n:div>

                <!-- Task cards -->
                <n:div class="task-cards-grid" id="taskCardsContainer">

                    <!-- Card: Design System Audit -->
                    <n:div class="task-card">
                        <n:div class="card-header">
                            <n:span class="status-badge in-progress">IN PROGRESS</n:span>
                            <button iconSclass="z-icon-ellipsis-v" sclass="card-menu-btn"/>
                        </n:div>
                        <n:div class="card-title">Design System Audit: Components &amp; Tokens</n:div>
                        <n:div class="card-desc">Review all core UI components against the new...</n:div>
                        <n:div class="card-footer">
                            <n:span class="priority-badge high">&#33; HIGH</n:span>
                            <n:div class="assignees">
                                <n:img class="avatar" src="" alt="A"/>
                                <n:img class="avatar" src="" alt="B"/>
                            </n:div>
                        </n:div>
                    </n:div>

                    <!-- Card: API Endpoint Migration -->
                    <n:div class="task-card">
                        <n:div class="card-header">
                            <n:span class="status-badge completed">COMPLETED</n:span>
                            <button iconSclass="z-icon-ellipsis-v" sclass="card-menu-btn"/>
                        </n:div>
                        <n:div class="card-title">API Endpoint Migration</n:div>
                        <n:div class="card-desc">Migrate existing legacy endpoints to the new Node.js...</n:div>
                        <n:div class="card-footer">
                            <n:span class="priority-badge medium">&#8776; MEDIUM</n:span>
                            <n:div class="assignees">
                                <n:img class="avatar" src="" alt="C"/>
                            </n:div>
                        </n:div>
                    </n:div>

                    <!-- Card: User Interview Synthesis -->
                    <n:div class="task-card">
                        <n:div class="card-header">
                            <n:span class="status-badge todo">TO DO</n:span>
                            <button iconSclass="z-icon-ellipsis-v" sclass="card-menu-btn"/>
                        </n:div>
                        <n:div class="card-title">User Interview Synthesis</n:div>
                        <n:div class="card-desc">Compile findings from the last 10 user interviews into a...</n:div>
                        <n:div class="card-footer">
                            <n:span class="priority-badge high">&#33; HIGH</n:span>
                            <n:div class="assignees">
                                <n:img class="avatar" src="" alt="D"/>
                                <n:img class="avatar" src="" alt="E"/>
                            </n:div>
                        </n:div>
                    </n:div>

                    <!-- Card: Onboarding Flow Redesign -->
                    <n:div class="task-card">
                        <n:div class="card-header">
                            <n:span class="status-badge in-progress">IN PROGRESS</n:span>
                            <button iconSclass="z-icon-ellipsis-v" sclass="card-menu-btn"/>
                        </n:div>
                        <n:div class="card-title">Onboarding Flow Redesign</n:div>
                        <n:div class="card-desc">Iterate on the user registration flow to reduce drop-off rate...</n:div>
                        <n:div class="card-footer">
                            <n:span class="priority-badge low">&#8595; LOW</n:span>
                            <n:div class="assignees">
                                <n:img class="avatar" src="" alt="F"/>
                                <n:img class="avatar" src="" alt="G"/>
                            </n:div>
                        </n:div>
                    </n:div>

                    <!-- Create New Task card -->
                    <n:div class="task-card create-card" id="createTaskCard">
                        <n:div class="create-inner">
                            <n:div class="create-icon">+</n:div>
                            <n:div class="create-label">Create New Task</n:div>
                        </n:div>
                    </n:div>

                </n:div>
            </div>
        </vlayout>
    </center>

</borderlayout>
</zk>
