<?page title="InsightPro - Data Analytics Dashboard"?>
<!-- Generated from: ui-screenshots/Data Analytics Dashboard.png.png -->
<zk xmlns:n="native">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f5f7fb; }

/* ── Navigation ── */
.db-nav {
    display: flex; align-items: center; padding: 0 24px; height: 56px;
    background: #fff; border-bottom: 1px solid #e5e7eb; gap: 0;
}
.db-nav-brand {
    display: flex; align-items: center; gap: 6px;
    font-weight: 700; font-size: 16px; color: #111827; margin-right: 32px; white-space: nowrap;
}
.db-nav-brand-icon {
    width: 28px; height: 28px; background: #2563eb; border-radius: 6px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-size: 12px; font-weight: 800;
}
.db-nav-links { display: flex; gap: 4px; flex: 1; }
.db-nav-link {
    padding: 6px 14px; text-decoration: none; color: #6b7280;
    font-size: 14px; font-weight: 500; border-bottom: 2px solid transparent;
}
.db-nav-link:hover { color: #374151; }
.db-nav-link.active { color: #2563eb; border-bottom-color: #2563eb; }
.db-nav-right { display: flex; align-items: center; gap: 12px; }
.db-search {
    display: flex; align-items: center; gap: 8px;
    border: 1px solid #e5e7eb; border-radius: 8px; padding: 6px 14px;
    font-size: 13px; color: #9ca3af; background: #f9fafb; white-space: nowrap;
}
.db-user-info { text-align: right; line-height: 1.3; }
.db-user-name { font-size: 13px; font-weight: 600; color: #111827; }
.db-user-role { font-size: 11px; color: #9ca3af; }
.db-avatar {
    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-size: 12px; font-weight: 600;
}

/* ── Main ── */
.db-main { padding: 20px 24px; }

/* ── Filter bar ── */
.db-filters {
    display: flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid #e5e7eb; border-radius: 10px;
    padding: 10px 16px; margin-bottom: 16px;
}
.db-filter-item {
    display: flex; align-items: center; gap: 6px;
    border: 1px solid #e5e7eb; border-radius: 8px; padding: 4px 10px; background: #fff;
}
.db-filter-icon { font-size: 13px; color: #6b7280; }
.db-filter-arrow { font-size: 10px; color: #9ca3af; margin-left: 2px; }
.db-filters-right { margin-left: auto; display: flex; gap: 8px; align-items: center; }

/* ── KPI cards ── */
.db-kpi-row { display: flex; gap: 16px; margin-bottom: 16px; }
.db-kpi-card {
    flex: 1; background: #fff; border: 1px solid #e5e7eb;
    border-radius: 12px; padding: 16px 20px; min-width: 0;
}
.db-kpi-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
.db-kpi-icon { font-size: 20px; }
.db-kpi-trend { font-size: 11px; font-weight: 600; padding: 2px 6px; border-radius: 4px; }
.db-kpi-trend.up   { color: #16a34a; background: #f0fdf4; }
.db-kpi-trend.down { color: #dc2626; background: #fef2f2; }
.db-kpi-label { font-size: 12px; color: #6b7280; margin-bottom: 4px; }
.kpi-value { font-size: 24px !important; font-weight: 700 !important; color: #111827 !important; display: block; }

/* ── Charts row ── */
.db-charts-row { display: flex; gap: 16px; margin-bottom: 16px; }
.chart-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px;
    min-width: 0; overflow: hidden;
}
.chart-card-lg { flex: 2; }
.chart-card-sm { flex: 1; }
.chart-card-header {
    display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2px;
}
.chart-title { font-size: 14px; font-weight: 600; color: #111827; }
.chart-subtitle { font-size: 11px; color: #9ca3af; margin: 2px 0 8px; }
.chart-menu-btn {
    background: none; border: none; color: #9ca3af; cursor: pointer;
    font-size: 18px; padding: 0 4px; line-height: 1;
}

/* ── Density Heatmap (HTML grid) ── */
.heatmap-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; margin-top: 8px; }
.hm-cell { border-radius: 4px; aspect-ratio: 1; }
.heatmap-legend { display: flex; justify-content: space-between; font-size: 10px; color: #9ca3af; margin-top: 6px; }

/* ── Department table ── */
.db-dept-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
    padding: 16px 16px 4px; overflow: hidden;
}
.db-dept-header {
    display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
}
.db-dept-title { font-size: 15px; font-weight: 600; color: #111827; }

/* Listbox overrides */
.dept-lb.z-listbox            { border: none !important; }
.dept-lb .z-listhead-bar      { background: #f9fafb !important; border-bottom: 1px solid #f3f4f6 !important; }
.dept-lb .z-listheader        { font-size: 11px !important; font-weight: 600 !important; color: #9ca3af !important; text-transform: uppercase; letter-spacing: .05em; }
.dept-lb .z-listitem:hover    { background: #f9fafb !important; }
.dept-lb .z-listcell          { font-size: 13px !important; color: #374151 !important; border-color: #f3f4f6 !important; padding: 10px 8px !important; }

.status-badge   { padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 500; }
.status-active  { background: #dcfce7; color: #16a34a; }
.status-onhold  { background: #fef3c7; color: #b45309; }

/* ── Regional chart legend ── */
.chart-legend { display: flex; gap: 16px; margin-top: 8px; justify-content: center; }
.chart-legend-item { display: flex; align-items: center; gap: 5px; font-size: 12px; color: #374151; }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

.perf-row  { display: flex; align-items: center; gap: 8px; }
.perf-bar-track { flex: 1; height: 6px; border-radius: 3px; background: #f3f4f6; max-width: 140px; }
.perf-bar-fill  { height: 6px; border-radius: 3px; }
.perf-bar-blue   { background: #2563eb; }
.perf-bar-orange { background: #f59e0b; }
.perf-num  { font-size: 12px; color: #374151; min-width: 28px; }

/* ── FAB ── */
.db-fab {
    position: fixed !important; bottom: 24px; right: 24px;
    width: 52px !important; height: 52px !important; border-radius: 50% !important;
    background: #2563eb !important; border: none !important; color: #fff !important;
    box-shadow: 0 4px 14px rgba(37,99,235,.45) !important; font-size: 20px !important;
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
}
.db-fab:hover { background: #1d4ed8 !important; }
</style>

<window id="mainWin" border="none" apply="zwriter.DataAnalyticsDashboardComposer">

    <!-- ── Top Navigation ── -->
    <n:nav class="db-nav">
        <n:div class="db-nav-brand">
            <n:span class="db-nav-brand-icon">IP</n:span>
            InsightPro
        </n:div>
        <n:div class="db-nav-links">
            <n:a href="#" class="db-nav-link active">Dashboard</n:a>
            <n:a href="#" class="db-nav-link">Reports</n:a>
            <n:a href="#" class="db-nav-link">Inventory</n:a>
            <n:a href="#" class="db-nav-link">Settings</n:a>
        </n:div>
        <n:div class="db-nav-right">
            <n:div class="db-search">&#128269; Search analytics...</n:div>
            <n:span style="font-size:20px;color:#6b7280;cursor:pointer">&#128276;</n:span>
            <n:div class="db-user-info">
                <n:div class="db-user-name">Alex Rivera</n:div>
                <n:div class="db-user-role">Admin</n:div>
            </n:div>
            <n:div class="db-avatar">AR</n:div>
        </n:div>
    </n:nav>

    <!-- ── Main Content ── -->
    <n:div class="db-main">

        <!-- Filter Bar -->
        <n:div class="db-filters">
                <combobox id="periodFilter" readonly="true" width="120px" style="border:none;background:transparent;"/>
                <combobox id="regionFilter" readonly="true" width="130px" style="border:none;background:transparent;"/>
                <combobox id="deptFilter"   readonly="true" width="150px" style="border:none;background:transparent;"/>
            <n:div class="db-filters-right">
                <button id="applyFiltersBtn" label="Apply Filters"
                        iconSclass="z-icon-filter" sclass="z-button-primary"/>
                <button id="refreshBtn" iconSclass="z-icon-refresh"/>
            </n:div>
        </n:div>

        <!-- KPI Cards -->
        <n:div class="db-kpi-row">
            <n:div class="db-kpi-card">
                <n:div class="db-kpi-top">
                    <n:span class="db-kpi-icon">&#128250;</n:span>
                    <n:span class="db-kpi-trend up">&#8599; 12.5%</n:span>
                </n:div>
                <n:div class="db-kpi-label">Total Revenue</n:div>
                <label id="totalRevenueLbl" sclass="kpi-value" value="$425,000"/>
            </n:div>
            <n:div class="db-kpi-card">
                <n:div class="db-kpi-top">
                    <n:span class="db-kpi-icon">&#128100;</n:span>
                    <n:span class="db-kpi-trend down">&#8600; 2.1%</n:span>
                </n:div>
                <n:div class="db-kpi-label">Active Users</n:div>
                <label id="activeUsersLbl" sclass="kpi-value" value="12,450"/>
            </n:div>
            <n:div class="db-kpi-card">
                <n:div class="db-kpi-top">
                    <n:span class="db-kpi-icon">&#128201;</n:span>
                    <n:span class="db-kpi-trend up">&#8599; 0.8%</n:span>
                </n:div>
                <n:div class="db-kpi-label">Conversion Rate</n:div>
                <label id="conversionRateLbl" sclass="kpi-value" value="3.2%"/>
            </n:div>
            <n:div class="db-kpi-card">
                <n:div class="db-kpi-top">
                    <n:span class="db-kpi-icon">&#9201;</n:span>
                    <n:span class="db-kpi-trend up">&#8599; 5.4%</n:span>
                </n:div>
                <n:div class="db-kpi-label">Avg. Session</n:div>
                <label id="avgSessionLbl" sclass="kpi-value" value="4m 32s"/>
            </n:div>
        </n:div>

        <!-- Charts Row -->
        <n:div class="db-charts-row">

            <!-- Revenue Trends — Area Chart -->
            <n:div class="chart-card chart-card-lg">
                <n:div class="chart-card-header">
                    <n:div>
                        <n:div class="chart-title">Revenue Trends Over Time</n:div>
                        <n:div class="chart-subtitle">Monthly revenue performance across all regions</n:div>
                    </n:div>
                    <n:button class="chart-menu-btn">&#8942;</n:button>
                </n:div>
                <charts id="revenueChart" type="area" height="230px" />
            </n:div>

            <!-- Regional Distribution — Donut Chart -->
            <n:div class="chart-card chart-card-sm">
                <n:div class="chart-card-header">
                    <n:div>
                        <n:div class="chart-title">Regional Distribution</n:div>
                        <n:div class="chart-subtitle">Revenue share by territory</n:div>
                    </n:div>
                    <n:button class="chart-menu-btn">&#8942;</n:button>
                </n:div>
                <charts id="regionalChart" type="pie" height="200px" />
                <n:div class="chart-legend">
                    <n:span class="chart-legend-item">
                        <n:span class="legend-dot" style="background:#2563eb;"/>
                        <n:span>North: 70%</n:span>
                    </n:span>
                    <n:span class="chart-legend-item">
                        <n:span class="legend-dot" style="background:#f59e0b;"/>
                        <n:span>South: 30%</n:span>
                    </n:span>
                </n:div>
            </n:div>

            <!-- Density Heatmap — HTML grid (no chart library needed) -->
            <n:div class="chart-card chart-card-sm">
                <n:div class="chart-card-header">
                    <n:div>
                        <n:div class="chart-title">Density Heatmap</n:div>
                        <n:div class="chart-subtitle">User activity density across departments</n:div>
                    </n:div>
                    <n:button class="chart-menu-btn">&#8942;</n:button>
                </n:div>
                <n:div class="heatmap-grid">
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                    <n:div class="hm-cell" style="background:#93c5fd"/>
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                    <n:div class="hm-cell" style="background:#bfdbfe"/>
                    <n:div class="hm-cell" style="background:#1d4ed8"/>
                    <n:div class="hm-cell" style="background:#bfdbfe"/>
                    <n:div class="hm-cell" style="background:#2563eb"/>
                    <n:div class="hm-cell" style="background:#93c5fd"/>
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                    <n:div class="hm-cell" style="background:#60a5fa"/>
                    <n:div class="hm-cell" style="background:#eff6ff"/>
                    <n:div class="hm-cell" style="background:#bfdbfe"/>
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                    <n:div class="hm-cell" style="background:#93c5fd"/>
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                    <n:div class="hm-cell" style="background:#bfdbfe"/>
                    <n:div class="hm-cell" style="background:#eff6ff"/>
                    <n:div class="hm-cell" style="background:#3b82f6"/>
                    <n:div class="hm-cell" style="background:#2563eb"/>
                    <n:div class="hm-cell" style="background:#bfdbfe"/>
                    <n:div class="hm-cell" style="background:#93c5fd"/>
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                    <n:div class="hm-cell" style="background:#bfdbfe"/>
                    <n:div class="hm-cell" style="background:#eff6ff"/>
                    <n:div class="hm-cell" style="background:#dbeafe"/>
                </n:div>
                <n:div class="heatmap-legend">
                    <n:span>LOW DENSITY</n:span>
                    <n:span>HIGH DENSITY</n:span>
                </n:div>
            </n:div>

        </n:div><!-- end charts-row -->

        <!-- Department Performance Table -->
        <n:div class="db-dept-card">
            <n:div class="db-dept-header">
                <n:span class="db-dept-title">Department Performance</n:span>
                <n:button class="chart-menu-btn">&#8942;</n:button>
            </n:div>
            <listbox id="deptListbox" hflex="1" sclass="dept-lb">
                <listhead>
                    <listheader label="DEPARTMENT" width="220px"/>
                    <listheader label="MANAGER"    width="200px"/>
                    <listheader label="STATUS"     width="130px"/>
                    <listheader label="PERFORMANCE" hflex="1"/>
                    <listheader label="ACTIONS"    width="80px"/>
                </listhead>
            </listbox>
        </n:div>

    </n:div><!-- end db-main -->

    <!-- Floating Action Button -->
    <button id="addBtn" iconSclass="z-icon-plus" sclass="db-fab" tooltiptext="Add New"/>

</window>
</zk>
