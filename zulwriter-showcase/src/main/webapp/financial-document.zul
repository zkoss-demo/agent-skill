<?xml version="1.0" encoding="UTF-8"?>
<?page title="Financial Document Processing"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:n="native"
    xmlns:ca="client/attribute">
    <borderlayout hflex="1" vflex="1"
                  viewModel="@id('vm') @init('zwriter.FinancialDocumentViewModel')">

        <!-- ===== NORTH: Document Header Form ===== -->
        <north border="none" size="auto">
            <vlayout style="padding: 10px">
                <hlayout valign="middle">
                    <label value="Financial Document Processing"
                           style="font-size: 20px; font-weight: bold"/>
                    <space hflex="1"/>
                    <label value="Document #:"
                           style="font-weight: bold"/>
                    <label value="@load(vm.document.documentNumber)"
                           style="color: #336699; font-weight: bold"/>
                </hlayout>
                <separator spacing="5px"/>
                <grid sclass="document-header-grid">
                    <columns>
                        <column width="130px" align="right"/>
                        <column hflex="1"/>
                        <column width="130px" align="right"/>
                        <column hflex="1"/>
                        <column width="130px" align="right"/>
                        <column hflex="1"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="Document Type:"/>
                            <combobox model="@load(vm.documentTypes)"
                                      selectedItem="@bind(vm.document.documentType)"
                                      hflex="1" readonly="true"
                                      constraint="no empty: Document type is required">
                                <template name="model" var="type">
                                    <comboitem label="@load(type)"/>
                                </template>
                            </combobox>
                            <label value="Document Date:"/>
                            <datebox value="@bind(vm.document.documentDate)"
                                     hflex="1" format="yyyy-MM-dd"
                                     constraint="no empty: Document date is required"/>
                            <label value="Currency:"/>
                            <combobox model="@load(vm.currencies)"
                                      selectedItem="@bind(vm.document.currency)"
                                      hflex="1" readonly="true"
                                      constraint="no empty: Currency is required">
                                <template name="model" var="curr">
                                    <comboitem label="@load(curr)"/>
                                </template>
                            </combobox>
                        </row>
                        <row>
                            <label value="Payee/Vendor:"/>
                            <bandbox hflex="1"
                                     value="@load(vm.document.payeeName)"
                                     readonly="true"
                                     ca:placeholder="Select payee...">
                                <bandpopup width="400px">
                                    <vlayout>
                                        <hlayout>
                                            <textbox value="@bind(vm.payeeSearchKeyword)"
                                                     hflex="1"
                                                     placeholder="Search payee..."
                                                     instant="true"
                                                     onChange="@command('searchPayee')"/>
                                            <button label="Search"
                                                    onClick="@command('searchPayee')"/>
                                        </hlayout>
                                        <listbox model="@load(vm.payeeResults)"
                                                 selectedItem="@bind(vm.document.payee)"
                                                 onSelect="@command('selectPayee')"
                                                 hflex="1"
                                                 height="200px">
                                            <listhead>
                                                <listheader label="Code" width="80px"/>
                                                <listheader label="Name" hflex="1"/>
                                            </listhead>
                                            <template name="model" var="payee">
                                                <listitem>
                                                    <listcell label="@load(payee.code)"/>
                                                    <listcell label="@load(payee.name)"/>
                                                </listitem>
                                            </template>
                                        </listbox>
                                    </vlayout>
                                </bandpopup>
                            </bandbox>
                            <label value="Department:"/>
                            <combobox model="@load(vm.departments)"
                                      selectedItem="@bind(vm.document.department)"
                                      hflex="1" readonly="true">
                                <template name="model" var="dept">
                                    <comboitem label="@load(dept)"/>
                                </template>
                            </combobox>
                            <label value="Total Amount:"/>
                            <decimalbox value="@load(vm.document.totalAmount)"
                                        hflex="1" format="#,##0.00"
                                        readonly="true"
                                        style="font-weight: bold; color: #006600"/>
                        </row>
                        <row>
                            <label value="Description:"/>
                            <cell colspan="5">
                                <textbox value="@bind(vm.document.description)"
                                         hflex="1" rows="2" multiline="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </vlayout>
        </north>

        <!-- ===== CENTER: Tabbed Interface ===== -->
        <center border="none">
            <tabbox hflex="1" vflex="1" style="padding: 0 10px">
                <tabs>
                    <tab label="Disbursement Lines"/>
                    <tab label="Posting Details"/>
                    <tab label="Attachments"/>
                    <tab label="Approval History"/>
                </tabs>
                <tabpanels>
                    <!-- ===== Tab 1: Disbursement Lines (Data Grid) ===== -->
                    <tabpanel vflex="1">
                        <vlayout vflex="1" hflex="1">
                            <hlayout valign="middle">
                                <button label="Add Line"
                                        onClick="@command('addLine')"
                                        iconSclass="z-icon-plus"/>
                                <button label="Remove Selected"
                                        onClick="@command('removeSelectedLines')"
                                        iconSclass="z-icon-trash"
                                        disabled="@load(empty vm.selectedLines)"/>
                                <space hflex="1"/>
                                <label value="Lines: "/>
                                <label value="@load(vm.lineItems.size())"
                                       style="font-weight: bold"/>
                            </hlayout>
                            <listbox model="@load(vm.lineItems)"
                                     selectedItems="@bind(vm.selectedLines)"
                                     hflex="1" vflex="1" multiple="true"
                                     checkmark="true"
                                     emptyMessage="No disbursement lines. Click 'Add Line' to begin.">
                                <listhead>
                                    <listheader label="#" width="40px" align="center"/>
                                    <listheader label="Account Code" width="130px"/>
                                    <listheader label="Account Name" hflex="2"/>
                                    <listheader label="Cost Center" width="120px"/>
                                    <listheader label="Description" hflex="2"/>
                                    <listheader label="Amount" width="130px" align="right"/>
                                    <listheader label="Tax Code" width="90px"/>
                                    <listheader label="Tax Amount" width="110px" align="right"/>
                                    <listheader label="Net Amount" width="120px" align="right"/>
                                    <listheader label="Actions" width="80px" align="center"/>
                                </listhead>
                                <template name="model" var="line">
                                    <listitem>
                                        <listcell label="@load(lineStatus.index + 1)"/>
                                        <listcell>
                                            <combobox model="@load(vm.accountCodes)"
                                                      selectedItem="@bind(line.accountCode)"
                                                      hflex="1" readonly="true"
                                                      onSelect="@command('onAccountSelect', line=line)">
                                                <template name="model" var="acct">
                                                    <comboitem label="@load(acct.code)"
                                                               description="@load(acct.name)"/>
                                                </template>
                                            </combobox>
                                        </listcell>
                                        <listcell label="@load(line.accountName)"/>
                                        <listcell>
                                            <combobox model="@load(vm.costCenters)"
                                                      selectedItem="@bind(line.costCenter)"
                                                      hflex="1" readonly="true">
                                                <template name="model" var="cc">
                                                    <comboitem label="@load(cc)"/>
                                                </template>
                                            </combobox>
                                        </listcell>
                                        <listcell>
                                            <textbox value="@bind(line.description)"
                                                     hflex="1"/>
                                        </listcell>
                                        <listcell>
                                            <decimalbox value="@bind(line.amount)"
                                                        hflex="1" format="#,##0.00"
                                                        onChange="@command('recalculateLine', line=line)"/>
                                        </listcell>
                                        <listcell>
                                            <combobox model="@load(vm.taxCodes)"
                                                      selectedItem="@bind(line.taxCode)"
                                                      hflex="1" readonly="true"
                                                      onSelect="@command('recalculateLine', line=line)">
                                                <template name="model" var="tax">
                                                    <comboitem label="@load(tax.code)"
                                                               description="@load(tax.description)"/>
                                                </template>
                                            </combobox>
                                        </listcell>
                                        <listcell>
                                            <decimalbox value="@load(line.taxAmount)"
                                                        hflex="1" format="#,##0.00"
                                                        readonly="true"/>
                                        </listcell>
                                        <listcell>
                                            <decimalbox value="@load(line.netAmount)"
                                                        hflex="1" format="#,##0.00"
                                                        readonly="true"
                                                        style="font-weight: bold"/>
                                        </listcell>
                                        <listcell>
                                            <button iconSclass="z-icon-pencil"
                                                    tooltiptext="Edit line"
                                                    onClick="@command('editLine', line=line)"/>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                            <!-- Line totals summary -->
                            <hlayout hflex="1" style="padding: 5px; background: #f5f5f5; border-top: 1px solid #ddd">
                                <space hflex="1"/>
                                <label value="Subtotal:" style="font-weight: bold"/>
                                <label value="@load(vm.subtotal) @converter('formattedNumber', format='#,##0.00')"
                                       style="font-weight: bold; width: 120px; text-align: right"
                                       width="120px"/>
                                <separator orient="vertical" spacing="20px"/>
                                <label value="Total Tax:" style="font-weight: bold"/>
                                <label value="@load(vm.totalTax) @converter('formattedNumber', format='#,##0.00')"
                                       style="width: 110px; text-align: right"
                                       width="110px"/>
                                <separator orient="vertical" spacing="20px"/>
                                <label value="Grand Total:" style="font-weight: bold; color: #006600"/>
                                <label value="@load(vm.grandTotal) @converter('formattedNumber', format='#,##0.00')"
                                       style="font-weight: bold; color: #006600; width: 120px; text-align: right"
                                       width="120px"/>
                            </hlayout>
                        </vlayout>
                    </tabpanel>

                    <!-- ===== Tab 2: Posting Details ===== -->
                    <tabpanel vflex="1">
                        <vlayout vflex="1" hflex="1" style="padding: 10px">
                            <grid hflex="1">
                                <columns>
                                    <column width="140px" align="right"/>
                                    <column hflex="1"/>
                                    <column width="140px" align="right"/>
                                    <column hflex="1"/>
                                </columns>
                                <rows>
                                    <row>
                                        <label value="Posting Date:"/>
                                        <datebox value="@bind(vm.document.postingDate)"
                                                 hflex="1" format="yyyy-MM-dd"/>
                                        <label value="Fiscal Period:"/>
                                        <combobox model="@load(vm.fiscalPeriods)"
                                                  selectedItem="@bind(vm.document.fiscalPeriod)"
                                                  hflex="1" readonly="true">
                                            <template name="model" var="period">
                                                <comboitem label="@load(period)"/>
                                            </template>
                                        </combobox>
                                    </row>
                                    <row>
                                        <label value="GL Account:"/>
                                        <textbox value="@bind(vm.document.glAccount)"
                                                 hflex="1"/>
                                        <label value="Reference No:"/>
                                        <textbox value="@bind(vm.document.referenceNumber)"
                                                 hflex="1"/>
                                    </row>
                                    <row>
                                        <label value="Posting Remarks:"/>
                                        <cell colspan="3">
                                            <textbox value="@bind(vm.document.postingRemarks)"
                                                     hflex="1" rows="3" multiline="true"/>
                                        </cell>
                                    </row>
                                </rows>
                            </grid>
                            <separator spacing="10px"/>
                            <label value="Journal Entries Preview"
                                   style="font-weight: bold; font-size: 14px"/>
                            <listbox model="@load(vm.journalEntries)"
                                     hflex="1" vflex="1"
                                     emptyMessage="No journal entries generated yet.">
                                <listhead>
                                    <listheader label="Account" hflex="2"/>
                                    <listheader label="Description" hflex="2"/>
                                    <listheader label="Debit" width="130px" align="right"/>
                                    <listheader label="Credit" width="130px" align="right"/>
                                </listhead>
                                <template name="model" var="entry">
                                    <listitem>
                                        <listcell label="@load(entry.account)"/>
                                        <listcell label="@load(entry.description)"/>
                                        <listcell label="@load(entry.debit) @converter('formattedNumber', format='#,##0.00')"/>
                                        <listcell label="@load(entry.credit) @converter('formattedNumber', format='#,##0.00')"/>
                                    </listitem>
                                </template>
                            </listbox>
                        </vlayout>
                    </tabpanel>

                    <!-- ===== Tab 3: Attachments ===== -->
                    <tabpanel vflex="1">
                        <vlayout vflex="1" hflex="1" style="padding: 10px">
                            <hlayout>
                                <button label="Upload Attachment"
                                        upload="true,maxsize=10240"
                                        onUpload="@command('uploadAttachment')"
                                        iconSclass="z-icon-upload"/>
                            </hlayout>
                            <separator spacing="5px"/>
                            <listbox model="@load(vm.attachments)"
                                     hflex="1" vflex="1"
                                     emptyMessage="No attachments uploaded.">
                                <listhead>
                                    <listheader label="File Name" hflex="2"/>
                                    <listheader label="Size" width="100px" align="right"/>
                                    <listheader label="Uploaded By" hflex="1"/>
                                    <listheader label="Upload Date" width="150px"/>
                                    <listheader label="Actions" width="120px" align="center"/>
                                </listhead>
                                <template name="model" var="att">
                                    <listitem>
                                        <listcell label="@load(att.fileName)"
                                                  iconSclass="z-icon-file"/>
                                        <listcell label="@load(att.fileSize)"/>
                                        <listcell label="@load(att.uploadedBy)"/>
                                        <listcell label="@load(att.uploadDate)"/>
                                        <listcell>
                                            <hlayout>
                                                <button iconSclass="z-icon-download"
                                                        tooltiptext="Download"
                                                        onClick="@command('downloadAttachment', att=att)"/>
                                                <button iconSclass="z-icon-trash"
                                                        tooltiptext="Delete"
                                                        onClick="@command('deleteAttachment', att=att)"/>
                                            </hlayout>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </vlayout>
                    </tabpanel>

                    <!-- ===== Tab 4: Approval History ===== -->
                    <tabpanel vflex="1">
                        <listbox model="@load(vm.approvalHistory)"
                                 hflex="1" vflex="1"
                                 emptyMessage="No approval history available."
                                 style="padding: 10px">
                            <listhead>
                                <listheader label="Step" width="60px" align="center"/>
                                <listheader label="Approver" hflex="1"/>
                                <listheader label="Action" width="120px"/>
                                <listheader label="Date" width="150px"/>
                                <listheader label="Comments" hflex="2"/>
                            </listhead>
                            <template name="model" var="hist">
                                <listitem>
                                    <listcell label="@load(hist.step)"/>
                                    <listcell label="@load(hist.approverName)"/>
                                    <listcell label="@load(hist.action)"/>
                                    <listcell label="@load(hist.actionDate)"/>
                                    <listcell label="@load(hist.comments)"/>
                                </listitem>
                            </template>
                        </listbox>
                    </tabpanel>
                </tabpanels>
            </tabbox>
        </center>

        <!-- ===== SOUTH: Action Radio Buttons + Save/Submit ===== -->
        <south border="none" size="auto">
            <vlayout style="padding: 10px; border-top: 2px solid #cccccc">
                <hlayout valign="middle" hflex="1">
                    <label value="Action:" style="font-weight: bold"/>
                    <radiogroup selectedItem="@bind(vm.selectedAction)">
                        <radio label="Save as Draft" value="DRAFT"/>
                        <radio label="Submit for Approval" value="SUBMIT"/>
                        <radio label="Approve" value="APPROVE"
                               visible="@load(vm.canApprove)"/>
                        <radio label="Reject" value="REJECT"
                               visible="@load(vm.canApprove)"/>
                        <radio label="Return for Revision" value="RETURN"
                               visible="@load(vm.canApprove)"/>
                    </radiogroup>
                    <space hflex="1"/>
                    <label value="Status: " style="font-weight: bold"/>
                    <label value="@load(vm.document.status)"
                           style="font-weight: bold; color: @load(vm.statusColor)"/>
                </hlayout>
                <hlayout visible="@load(vm.selectedAction eq 'REJECT' or vm.selectedAction eq 'RETURN')">
                    <label value="Comments:" style="font-weight: bold"/>
                    <textbox value="@bind(vm.actionComments)"
                             hflex="1" rows="2" multiline="true"
                             constraint="no empty: Comments are required for this action"/>
                </hlayout>
                <separator spacing="5px"/>
                <hlayout>
                    <button label="Execute Action"
                            onClick="@command('executeAction')"
                            iconSclass="z-icon-check"
                            disabled="@load(vm.selectedAction eq null)"
                            sclass="btn-primary"/>
                    <button label="Save"
                            onClick="@command('save')"
                            iconSclass="z-icon-save"/>
                    <button label="Print Preview"
                            onClick="@command('printPreview')"
                            iconSclass="z-icon-print"/>
                    <space hflex="1"/>
                    <button label="Cancel"
                            onClick="@command('cancel')"
                            iconSclass="z-icon-times"/>
                </hlayout>
            </vlayout>
        </south>
    </borderlayout>
</zk>
