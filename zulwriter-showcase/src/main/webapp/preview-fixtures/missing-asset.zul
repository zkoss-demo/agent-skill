<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture for the WARNINGS asset contract, and for the line between the two causes.
     `~./` asks the classpath, and a miss there means a jar is absent, so it keeps its own
     wording. The other two ask the docroot, which launcher 1.0.3 serves, so a miss there is a
     real missing file and is reported per URL. present-pixel.png is the negative control and
     is the reason this fixture is worth more than it was: on 1.0.2 nothing under the docroot
     was served at all, so "a served asset stays quiet" could not be asserted. Before any of
     this, the two docroot misses produced a blank box in the image and complete silence in
     the text, which is the one combination a reader cannot resolve. -->
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
	<vlayout>
		<image id="okImage" src="/preview-fixtures/present-pixel.png"/>
		<image id="docrootMiss" src="/img/does-not-exist.png"/>
		<image id="classpathMiss" src="~./img/does-not-exist.png"/>
		<n:img id="nativeMiss" src="/assets/nope.svg"/>
	</vlayout>
</zk>
