<?xml version="1.0" encoding="UTF-8"?>
<?page title="Event Management"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:n="native">
    <borderlayout hflex="1" vflex="1"
                  viewModel="@id('vm') @init('zwriter.EventManagementViewModel')">

        <!-- Header with Title and Bulk Actions -->
        <north height="auto" border="none">
            <vlayout hflex="1" spacing="0">

                <!-- Title Bar -->
                <div sclass="event-mgmt-header"
                     style="background: #1565c0; color: white; padding: 12px 24px;
                            display: flex; align-items: center">
                    <hlayout valign="middle" hflex="1"
                             style="height: 100%; align-items: center">
                        <label value="Event Management"
                               style="font-size: 20px; font-weight: bold; color: white"/>
                        <space hflex="1"/>
                        <label value="@load(vm.totalSize)"
                               style="font-size: 13px; color: rgba(255,255,255,0.85)">
                            <attribute name="value">
                                @load(c:cat3(vm.totalSize, ' event', vm.totalSize == 1 ? '' : 's'))
                            </attribute>
                        </label>
                    </hlayout>
                </div>

                <!-- Search Filter Bar -->
                <div style="background: #f5f5f5; padding: 12px 24px;
                            border-bottom: 1px solid #e0e0e0">
                    <hlayout valign="middle" spacing="12px">

                        <!-- Status Filter -->
                        <label value="Status:" style="font-weight: 500; color: #555"/>
                        <combobox model="@load(vm.statusOptions)"
                                  selectedItem="@bind(vm.filterStatus)"
                                  readonly="true" width="150px"
                                  placeholder="All Statuses">
                            <template name="model" var="status">
                                <comboitem label="@load(status)"/>
                            </template>
                        </combobox>

                        <!-- Date Range Filter -->
                        <label value="From:" style="font-weight: 500; color: #555"/>
                        <datebox value="@bind(vm.filterDateFrom)"
                                 width="160px" format="yyyy-MM-dd"
                                 placeholder="Start date"/>

                        <label value="To:" style="font-weight: 500; color: #555"/>
                        <datebox value="@bind(vm.filterDateTo)"
                                 width="160px" format="yyyy-MM-dd"
                                 placeholder="End date"/>

                        <space hflex="1"/>

                        <!-- Search / Reset Buttons -->
                        <button label="Search"
                                iconSclass="z-icon-search"
                                onClick="@command('search')"/>
                        <button label="Reset"
                                iconSclass="z-icon-undo"
                                onClick="@command('resetFilters')"/>
                    </hlayout>
                </div>

                <!-- Bulk Action Bar -->
                <div style="background: white; padding: 8px 24px;
                            border-bottom: 1px solid #e0e0e0"
                     visible="@load(not empty vm.selectedEvents)">
                    <hlayout valign="middle" spacing="8px">
                        <label value="@load(c:cat3(vm.selectedEvents.size(), ' item', vm.selectedEvents.size() == 1 ? '' : 's'))"
                               style="font-weight: 500; color: #1565c0; margin-right: 8px"/>
                        <label value="selected" style="color: #666; margin-right: 16px"/>
                        <button label="Approve"
                                iconSclass="z-icon-check"
                                onClick="@command('bulkApprove')"/>
                        <button label="Reject"
                                iconSclass="z-icon-times"
                                onClick="@command('bulkReject')"/>
                        <button label="Delete"
                                iconSclass="z-icon-trash"
                                onClick="@command('bulkDelete')"/>
                        <space hflex="1"/>
                        <button label="Clear Selection"
                                onClick="@command('clearSelection')"/>
                    </hlayout>
                </div>

            </vlayout>
        </north>

        <!-- Main Data Grid -->
        <center border="none">
            <listbox model="@load(vm.events)"
                     selectedItems="@bind(vm.selectedEvents)"
                     checkmark="true" multiple="true"
                     hflex="1" vflex="1"
                     emptyMessage="No events found matching the criteria.">
                <listhead>
                    <listheader label="Event ID" width="120px"
                                sort="auto(eventId)"/>
                    <listheader label="Type" width="130px"
                                sort="auto(type)"/>
                    <listheader label="Status" width="110px"
                                sort="auto(status)"/>
                    <listheader label="Context" hflex="2"
                                sort="auto(context)"/>
                    <listheader label="Created" width="160px"
                                sort="auto(createdAt)"/>
                    <listheader label="Updated" width="160px"
                                sort="auto(updatedAt)"/>
                    <listheader label="Actions" width="140px"
                                align="center"/>
                </listhead>
                <template name="model" var="event">
                    <listitem>
                        <listcell label="@load(event.eventId)"/>
                        <listcell label="@load(event.type)"/>
                        <listcell>
                            <label value="@load(event.status)"
                                   sclass="@load(c:cat('event-status-', event.status))"/>
                        </listcell>
                        <listcell label="@load(event.context)"
                                  tooltiptext="@load(event.context)"/>
                        <listcell label="@load(event.createdAt) @converter('formattedDate', format='yyyy-MM-dd HH:mm')"/>
                        <listcell label="@load(event.updatedAt) @converter('formattedDate', format='yyyy-MM-dd HH:mm')"/>
                        <listcell>
                            <hlayout spacing="4px">
                                <button label="View"
                                        iconSclass="z-icon-eye"
                                        onClick="@command('viewEvent', event=event)"/>
                                <button label="Edit"
                                        iconSclass="z-icon-edit"
                                        onClick="@command('editEvent', event=event)"/>
                            </hlayout>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </center>

        <!-- Pagination Footer -->
        <south height="auto" border="none">
            <div style="background: #fafafa; padding: 8px 24px;
                        border-top: 1px solid #e0e0e0">
                <hlayout valign="middle" hflex="1">
                    <label value="@load(c:cat3('Showing page ', vm.activePage + 1, c:cat3(' of ', vm.totalPages, c:cat(' (', c:cat(vm.totalSize, ' total)')))))"
                           style="color: #666; font-size: 13px"/>
                    <space hflex="1"/>
                    <paging totalSize="@load(vm.totalSize)"
                            pageSize="@load(vm.pageSize)"
                            activePage="@bind(vm.activePage)"
                            onPaging="@command('onPaging')"/>
                </hlayout>
            </div>
        </south>

    </borderlayout>
</zk>
